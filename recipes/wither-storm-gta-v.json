    {
      "action": "extract",
      "download": "wither-storm-gta-v",
      "to": "{game:gta-v-legacy}"
    },
    {
      "action": "prism-instance"
    },
    {
      "action": "xml-set",
      "file": "{documents}/Rockstar Games/GTA V/settings.xml",
      "element": "PauseOnFocusLoss",
      "attribute": "value",
      "value": "0"
    },
    {
      "action": "xml-set",
      "file": "{documents}/Rockstar Games/GTA V/settings.xml",
      "element": "Windowed",
      "attribute": "value",
      "value": "2"
    }
