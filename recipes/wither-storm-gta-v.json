  "aiBuilt": true,
  "knownIssues": [
    "In GTA, press F9 to bring the Wither Storm in ahead of you, or Shift+F9 for one that's already grown. F10 makes it grow, F11 sends it away and Shift+F11 starts its death.",
    "A Minecraft window opens too and stays open behind GTA V. It draws the storm you see in GTA, so leave it open.",
    "Story mode only. GTA starts with BattlEye off, which keeps GTA Online out; never take a modded game online.",
    "Pick Story Mode on GTA's start screen yourself.",
    "A GTA update stops it until a new Script Hook V comes out.",
    "It uses the same GTA V files as Minecraft x GTA V, so have only one of the two installed at a time. Remove the other one first.",
    "The storm lifts and swallows people and cars, but GTA's roads and buildings stay standing.",
    "F7 turns the link with Minecraft off and on; F8 levels Minecraft's ground where you stand."
  ],
  "important": [
    {
      "text": "Script Hook V links GTA V with Minecraft. It comes only from its author's own site, so you press Download there. We do everything else.",
      "link": "https://www.dev-c.com/gtav/scripthookv/",
      "linkLabel": "Get Script Hook V",
      "blocksInstall": true,
      "input": {
        "id": "script-hook-v",
        "kind": "zip",
        "name": "Script Hook V",
        "label": "The Script Hook V zip",
        "mustContain": [
          "ScriptHookV.dll",
          "dinput8.dll"
        ],
        "find": {
          "folder": "downloads",
          "name": "^ScriptHookV_.*\\.zip$",
          "exclude": "DotNet"
        },
        "wrongFiles": [
          {
            "name": "_SDK_",
            "contains": [
              "ScriptHookV.lib",
              "main.h"
            ],
            "message": "That's the Script Hook V developer kit, not Script Hook V itself. On the author's page, use the Download link just above it."
          }
        ],
        "versionCheck": {
          "file": "ScriptHookV.dll",
          "game": "gta-v-legacy",
          "rule": "game-build"
        },
        "origin": {
          "hosts": [
            "dev-c.com"
          ]
        }
      }
    },
    {
      "text": "The storm itself is Cracker's Wither Storm Mod. Its author shares it on CurseForge, so you press Download on its page. We check the file and do everything else.",
      "link": "https://www.curseforge.com/minecraft/mc-mods/crackers-wither-storm-mod/files/5619741",
      "linkLabel": "Get the Wither Storm mod",
      "blocksInstall": true,
      "input": {
        "id": "wither-storm-mod",
        "kind": "zip",
        "name": "Cracker's Wither Storm Mod",
        "label": "The Wither Storm mod file",
        "mustContain": [
          "mods.toml"
        ],
        "find": {
          "folder": "downloads",
          "name": "^witherstormmod-1\\.20\\.1-4\\.2\\.1-all.*\\.jar$",
          "maxSizeMb": 100
        },
        "sha256": [
          "a23c019b1465c87ba506ada49aa815866e5353ebdc2be3284d9087ff080018ac"
        ],
        "origin": {
          "hosts": [
            "curseforge.com",
            "forgecdn.net"
          ]
        }
      }
    }
  ],
  "conflictsWith": [
    "minecraft-gta-v"
  ]
