  "launch": {
    "steps": [
      {
        "order": 1,
        "target": "prism",
        "waitFor": {
          "logFile": "{prism-instance}/logs/latest.log",
          "pattern": "host link listening",
          "message": "Getting Minecraft ready. The first start downloads Minecraft and Forge and takes a few minutes.",
          "timeoutSeconds": 1800
        }
      },
      {
        "order": 2,
        "target": "game",
        "gameKey": "gta-v-legacy",
        "via": "steam",
        "args": [
          "-nobattleye"
        ]
      }
    ],
    "ready": {
      "logFile": "{prism-instance}/logs/latest.log",
      "pattern": "host connected from"
    }
  },
  "saves": [
    {
      "gameKey": "gta-v-legacy",
      "path": "{documents}/Rockstar Games/GTA V/Profiles"
    },
    {
      "gameKey": "minecraft-java",
      "path": "{prism-instance}/saves"
    }
  ],
  "requirements": {
    "notes": "Both games render at once and a grown storm is heavy, so it needs a strong PC. GTA runs best windowed with Pause on focus loss off. Minecraft's window stays open in the background."
  },
