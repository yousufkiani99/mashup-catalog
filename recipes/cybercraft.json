  "steps": [
    {
      "action": "extract",
      "download": "cyber-engine-tweaks",
      "to": "{game:cyberpunk-2077}"
    },
    {
      "action": "extract",
      "download": "red4ext",
      "to": "{game:cyberpunk-2077}"
    },
    {
      "action": "extract",
      "download": "redscript",
      "to": "{game:cyberpunk-2077}"
    },
    {
      "action": "extract",
      "download": "codeware",
      "to": "{game:cyberpunk-2077}"
    },
    {
      "action": "extract",
      "download": "cybercraft",
      "to": "{game:cyberpunk-2077}",
      "only": [
        "red4ext/plugins/BlockRender/BlockRender.dll",
        "red4ext/plugins/BlockRender/shaders/**",
        "red4ext/plugins/BlockRender/Scripts/**",
        "red4ext/plugins/BlockRender/LICENSE.txt",
        "red4ext/plugins/BlockRender/THIRD_PARTY_NOTICES.txt",
        "bin/x64/plugins/cyber_engine_tweaks/mods/blockrender_hud/**"
      ]
    },
    {
      "action": "prism-instance"
    }
  ],
  "launch": {
    "steps": [
      {
        "order": 1,
        "target": "prism",
        "waitFor": {
          "logFile": "{prism-instance}/logs/latest.log",
          "pattern": "Backend library: LWJGL|Sound engine started|Error starting SoundSystem",
          "message": "Getting Minecraft ready. The first start downloads Minecraft and takes a few minutes.",
          "timeoutSeconds": 1800
        }
      },
      {
        "order": 2,
        "target": "game",
        "gameKey": "cyberpunk-2077",
        "via": "steam",
        "args": [
          "--launcher-skip"
        ]
      }
    ]
  },
  "saves": [
    {
      "gameKey": "minecraft-java",
      "path": "{prism-instance}/saves"
    }
  ],
  "requirements": {
    "ramGb": 3,
    "notes": "Both games run at once, so it needs a strong PC. Tested by its creator on an NVIDIA card with DLSS."
  },
  "conflictsWith": [
    "minepunk"
  ],
  "credits": [
    {
      "name": "ItzBloxy",
      "role": "Creator of CyberCraft (BlockRender)",
      "url": "https://github.com/ItzBloxy"
    },
    {
      "name": "chasmlol",
      "role": "SkyCraft, whose Minecraft side CyberCraft uses",
      "url": "https://github.com/chasmlol"
    }
  ],
  "licence": {
    "spdx": "MIT",
    "url": "https://github.com/ItzBloxy/CyberCraft/blob/main/LICENSE",
    "permission": "not-needed"
  },
  "links": {
    "source": "https://github.com/ItzBloxy/CyberCraft",
    "manualInstall": "https://github.com/ItzBloxy/CyberCraft#readme"
  },
  "media": {},
  "aiBuilt": false,
  "knownIssues": [
    "Only Cyberpunk 2077 2.31 works.",
    "Can't be installed together with Minepunk: both change Cyberpunk the same way."
  ],
  "loaderOptions": {
    "blockAtlas": {
      "gameKey": "cyberpunk-2077",
      "outDir": "{game:cyberpunk-2077}/red4ext/plugins/BlockRender",
      "format": "blockrender-v1",
      "minecraftVersion": "26.3"
    }
  }
}
