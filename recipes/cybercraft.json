{
  "schemaVersion": 5,
  "id": "cybercraft",
  "title": "CyberCraft",
  "tagline": "Minecraft blocks in Night City, lit by the city's own lights and upscaled with DLSS.",
  "description": "SkyCraft's Minecraft brought to Cyberpunk 2077: blocks are drawn into the game's own picture, lit by Night City and kept sharp by DLSS. Press F8 to build as a Minecraft player, then give control back to V. Minecraft's block textures are made from your own Minecraft the first time you press Play.",
  "method": "passthrough",
  "tier": "unlocked",
  "testLabel": "beta",
  "games": [
    {
      "role": "host",
      "key": "cyberpunk-2077",
      "name": "Cyberpunk 2077",
      "store": "steam",
      "steamAppId": "1091500",
      "version": {
        "kind": "any",
        "note": "Needs game version 2.31 (base game; Phantom Liberty wasn't tested). Other versions need matching mod updates first."
      }
    },
    {
      "role": "guest",
      "key": "minecraft-java",
      "name": "Minecraft: Java Edition",
      "store": "minecraft",
      "version": {
        "kind": "any",
        "note": "A Microsoft account that owns Minecraft: Java Edition. The app sets up Minecraft 26.3 itself."
      }
    }
  ],
  "minecraft": {
