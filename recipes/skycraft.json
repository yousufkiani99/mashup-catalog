{
  "schemaVersion": 1,
  "id": "skycraft",
  "title": "SkyCraft",
  "tagline": "Play Skyrim as a Minecraft player: place blocks, dig and fight in Skyrim's world.",
  "description": "Walk through Skyrim with Minecraft's movement, inventory and HUD. Place and break blocks anywhere, dig into the ground, light the world with torches, and fight Skyrim's people and creatures with Minecraft weapons while they fight back. Your Skyrim skills still level up as you play. Both games run at the same time: Minecraft runs hidden and Skyrim draws everything.",
  "method": "passthrough",
  "tier": "unlocked",
  "testLabel": "beta",
  "games": [
    {
      "role": "host",
      "key": "skyrim-se",
      "name": "The Elder Scrolls V: Skyrim Special Edition",
      "store": "steam",
      "steamAppId": "489830",
      "version": {
        "kind": "exeVersions",
        "values": ["1.7.104.0"],
        "note": "Needs the Anniversary Edition runtime. Developed and tested on 1.7.104. Not 1.5.97, not VR."
      }
    },
    {
      "role": "guest",
      "key": "minecraft-java",
      "name": "Minecraft: Java Edition",
      "store": "minecraft",
      "version": {
        "kind": "any",
        "note": "A Microsoft account that owns Minecraft: Java Edition. The app sets up Minecraft 26.3 itself."
      }
    }
  ],
  "minecraft": {
    "gameVersion": "26.3",
    "loader": "fabric",
    "loaderVersion": "0.19.5",
    "fabricApiVersion": "0.161.0+26.3",
    "javaMajor": 25,
    "mods": ["skycraft-fabric", "fabric-api"],
    "instanceName": "SkyCraft",
    "jvmArgs": ["--enable-native-access=ALL-UNNAMED", "-Dskycraft.startHidden=true"],
    "maxMemoryMb": 4096
  },
  "downloads": [
    {
      "id": "skycraft",
      "name": "SkyCraft 0.1.2 (Skyrim side)",
      "url": "https://github.com/chasmlol/SkyCraft/releases/download/v0.1.2/SkyCraft-0.1.2.zip",
      "sha256": "1133ecde384d70d5261cbc9ba149bc7b544e1653b78846a1623b56241bb392c3",
      "sizeBytes": 25111237,
      "kind": "mashup",
      "source": "github-release",
      "licence": "MIT",
      "fileName": "SkyCraft-0.1.2.zip"
    },
    {
      "id": "skycraft-fabric",
      "name": "SkyCraft 0.1.2 (Minecraft side)",
      "url": "https://github.com/chasmlol/SkyCraft/releases/download/v0.1.2/skycraft-fabric-0.1.2.jar",
      "sha256": "ea429c73dcec49d39b6a0bb9b17ad08a6b0290a39a96ccf6f6c07d581cf992d9",
      "sizeBytes": 247869,
      "kind": "mashup",
      "source": "github-release",
      "licence": "MIT",
      "fileName": "skycraft-fabric-0.1.2.jar"
    },
    {
      "id": "skse64",
      "name": "Skyrim Script Extender (SKSE64) 2.3.1",
      "url": "https://www.nexusmods.com/skyrimspecialedition/mods/30379?tab=files",
      "sha256": "7bad616ed360823a027f8828801d91e3a4aa2eacd952023af7f3e31adb2ae250",
      "sizeBytes": 952607,
      "kind": "loader",
      "source": "nexus",
      "nexus": { "gameDomain": "skyrimspecialedition", "modId": 30379 },
      "licence": "SKSE licence: free, no re-hosting (official site skse.silverlock.org)",
      "fileName": "skse64_2_03_01.7z",
      "pins": { "version": "2.3.1", "gameVersions": ["1.7.104.0"] }
    },
    {
      "id": "address-library",
      "name": "Address Library for SKSE Plugins (All in one, 1.7.104.0) v13",
      "url": "https://www.nexusmods.com/skyrimspecialedition/mods/32444?tab=files",
      "sha256": "be0c7c07fb63fd1c1403690d4797c7a8fdf8799118acceb605f285d7b0ee055f",
      "sizeBytes": 6640552,
      "kind": "dependency",
      "source": "nexus",
      "nexus": { "gameDomain": "skyrimspecialedition", "modId": 32444, "fileId": 795954 },
      "licence": "Nexus Mods permissions (meh321)",
      "fileName": "address-library-skse-all-in-one-1.7.104.0-v13.zip"
    },
    {
      "id": "prism-launcher",
      "name": "Prism Launcher 11.1.1 (portable)",
      "url": "https://github.com/PrismLauncher/PrismLauncher/releases/download/11.1.1/PrismLauncher-Windows-MSVC-Portable-11.1.1.zip",
      "sha256": "ab35a770fb06d89d2ccc098079db5db329fb4e68f42b72babd8b095efde3d2d7",
      "sizeBytes": 20396629,
      "kind": "tool",
