      "licence": "GPL-3.0-only",
      "fileName": "PrismLauncher-Windows-MSVC-Portable-11.1.1.zip"
    },
    {
      "id": "fabric-api",
      "name": "Fabric API 0.161.0 for Minecraft 26.3",
      "url": "https://github.com/FabricMC/fabric/releases/download/0.161.0%2B26.3/fabric-api-0.161.0%2B26.3.jar",
      "sha256": "86f16178a3cecc887a85a4cfe9a79d92fa7341d8f39b5951a4d6ad800ab657a6",
      "sizeBytes": 2620967,
      "kind": "dependency",
      "source": "github-release",
      "licence": "Apache-2.0",
      "fileName": "fabric-api-0.161.0+26.3.jar"
    }
  ],
  "steps": [
    {
      "action": "extract",
      "download": "skse64",
      "to": "{game:skyrim-se}",
      "stripTopFolder": true,
      "only": ["*.exe", "*.dll", "Data/**"]
    },
    {
      "action": "extract",
      "download": "address-library",
      "to": "{game:skyrim-se}/Data",
      "only": ["SKSE/Plugins/versionlib-1-7-104-0.bin"]
    },
    {
      "action": "extract",
      "download": "skycraft",
      "to": "{game:skyrim-se}/Data",
      "only": [
        "SKSE/Plugins/SkyCraft.dll",
        "SKSE/Plugins/SkyCraft.ini",
        "SKSE/Plugins/SkyCraft/LICENSE.txt",
        "SKSE/Plugins/SkyCraft/THIRD-PARTY-NOTICES.md"
      ]
    },
    {
      "action": "ini-set",
      "file": "{game:skyrim-se}/Data/SKSE/Plugins/SkyCraft.ini",
      "section": "Minecraft",
      "key": "bStartWithSkyrim",
      "value": "0"
    },
    { "action": "prism-instance" }
  ],
  "launch": {
    "steps": [
      { "order": 1, "target": "prism" },
      {
        "order": 2,
        "target": "game",
        "gameKey": "skyrim-se",
        "via": "loader",
        "exe": "{game:skyrim-se}/skse64_loader.exe"
      }
    ],
    "ready": {
      "logFile": "{documents}/My Games/Skyrim Special Edition/SKSE/SkyCraft.log",
      "pattern": "Minecraft connected"
    }
  },
  "saves": [
    { "gameKey": "skyrim-se", "path": "{documents}/My Games/Skyrim Special Edition/Saves" },
    { "gameKey": "minecraft-java", "path": "{prism-instance}/saves" }
  ],
  "requirements": {
    "ramGb": 3,
    "notes": "About 3 GB of extra RAM for Minecraft, about 1.5 GB of disk for Minecraft's files, and a graphics card that runs Minecraft 26.3."
  },
  "credits": [
    { "name": "chasmlol", "role": "Creator of SkyCraft", "url": "https://github.com/chasmlol" }
  ],
  "licence": {
    "spdx": "MIT",
    "url": "https://github.com/chasmlol/SkyCraft/blob/v0.1.2/LICENSE",
    "permission": "pending"
  },
  "links": {
    "source": "https://github.com/chasmlol/SkyCraft",
    "manualInstall": "https://github.com/chasmlol/SkyCraft#installing"
  },
  "media": {},
  "aiBuilt": true,
  "knownIssues": [
    "Skyrim's opening (the cart ride and Helgen) can leave you stuck. Play from a save made after Helgen, or use the Alternate Start mod.",
    "Skyrim's inventory, magic, shouts and perks can't be opened while Minecraft is in control.",
    "Minecraft weapons hit Skyrim's people and creatures, but not objects such as the web in Bleak Falls Barrow.",
    "Text on signs isn't drawn yet.",
    "All Skyrim interiors share one Minecraft world, so blocks placed in one interior can show up in another.",
    "Mods that also control the camera (Improved Camera SE, SmoothCam, True Directional Movement) don't work alongside it."
  ]
}
