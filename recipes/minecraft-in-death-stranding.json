  "steps": [
    {
      "action": "run",
      "download": "reshade-setup",
      "args": ["{exe:death-stranding-dc}", "--api", "dxgi", "--headless"],
      "waitForExit": true,
      "note": "Installs ReShade (the version with add-on support) into Death Stranding as dxgi.dll. Nothing shows on screen."
    },
    {
      "action": "ini-set",
      "file": "{game:death-stranding-dc}/ReShade.ini",
      "section": "GENERAL",
      "key": "EffectSearchPaths",
      "value": ".\\reshade-shaders\\Shaders\\**"
    },
    {
      "action": "ini-set",
      "file": "{game:death-stranding-dc}/ReShade.ini",
      "section": "GENERAL",
      "key": "TextureSearchPaths",
      "value": ".\\reshade-shaders\\Textures\\**"
    },
    {
      "action": "ini-set",
      "file": "{game:death-stranding-dc}/ReShade.ini",
      "section": "GENERAL",
      "key": "PresetPath",
      "value": ".\\ReShadePreset.ini"
    },
    {
      "action": "ini-set",
      "file": "{game:death-stranding-dc}/ReShade.ini",
      "section": "GENERAL",
      "key": "PerformanceMode",
      "value": "0"
    },
    {
      "action": "ini-set",
      "file": "{game:death-stranding-dc}/ReShade.ini",
      "section": "GENERAL",
      "key": "PreprocessorDefinitions",
      "value": "RESHADE_DEPTH_INPUT_IS_REVERSED=1,RESHADE_DEPTH_INPUT_IS_UPSIDE_DOWN=0,RESHADE_DEPTH_INPUT_IS_LOGARITHMIC=0,RESHADE_DEPTH_LINEARIZATION_FAR_PLANE=1000.0"
    },
    {
      "action": "ini-set",
      "file": "{game:death-stranding-dc}/ReShade.ini",
      "section": "ADDON",
      "key": "AddonPath",
      "value": ".\\"
    },
    {
      "action": "ini-set",
      "file": "{game:death-stranding-dc}/ReShade.ini",
      "section": "DEPTH",
      "key": "DepthCopyAtClearIndex",
      "value": "0"
    },
    {
      "action": "ini-set",
      "file": "{game:death-stranding-dc}/ReShade.ini",
      "section": "DEPTH",
      "key": "DepthCopyBeforeClears",
      "value": "1"
    },
    {
      "action": "ini-set",
      "file": "{game:death-stranding-dc}/ReShade.ini",
      "section": "DEPTH",
      "key": "UseAspectRatioHeuristics",
      "value": "1"
    },
    {
      "action": "ini-set",
      "file": "{game:death-stranding-dc}/ReShade.ini",
      "section": "INPUT",
      "key": "KeyOverlay",
      "value": "36,0,0,0"
    },
    {
      "action": "ini-set",
      "file": "{game:death-stranding-dc}/ReShade.ini",
      "section": "INPUT",
      "key": "KeyScreenshot",
      "value": "35,0,0,0"
    },
    {
      "action": "ini-set",
      "file": "{game:death-stranding-dc}/ReShade.ini",
      "section": "OVERLAY",
      "key": "TutorialProgress",
      "value": "4"
    },
    {
      "action": "ini-set",
      "file": "{game:death-stranding-dc}/ReShade.ini",
      "section": "SCREENSHOT",
      "key": "FileFormat",
      "value": "1"
    },
    {
      "action": "ini-set",
      "file": "{game:death-stranding-dc}/ReShade.ini",
      "section": "SCREENSHOT",
      "key": "ClearAlpha",
      "value": "1"
    },
    {
      "action": "copy",
      "download": "reshade-fxh",
      "to": "{game:death-stranding-dc}/reshade-shaders/Shaders"
    },
    {
      "action": "copy",
      "download": "reshadeui-fxh",
      "to": "{game:death-stranding-dc}/reshade-shaders/Shaders"
    },
    {
      "action": "copy",
      "download": "displaydepth-fx",
      "to": "{game:death-stranding-dc}/reshade-shaders/Shaders"
    },
    {
      "action": "copy",
      "download": "displaydepth-l10n-fxh",
      "to": "{game:death-stranding-dc}/reshade-shaders/Shaders"
    },
    { "action": "extract", "download": "ds-minecraft", "to": "{game:death-stranding-dc}" },
    { "action": "prism-instance" }
  ],
  "launch": {
    "steps": [
      { "order": 1, "target": "prism" },
      { "order": 2, "target": "game", "gameKey": "death-stranding-dc", "via": "steam" }
    ],
    "ready": {
      "logFile": "{prism-instance}/logs/latest.log",
      "pattern": "host connected from"
    }
  },
  "saves": [
    {
      "gameKey": "death-stranding-dc",
      "path": "{localappdata}/KojimaProductions/DeathStrandingDC"
    },
    { "gameKey": "minecraft-java", "path": "{prism-instance}/saves" }
  ],
  "requirements": {
    "notes": "Minecraft draws a second picture alongside Death Stranding, so expect a lower frame rate (about 120 to 55 fps on the creator's PC). Minecraft's window stays open in the background."
  },
