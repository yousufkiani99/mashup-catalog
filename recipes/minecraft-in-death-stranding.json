{
  "schemaVersion": 1,
  "id": "minecraft-in-death-stranding",
  "title": "Minecraft in Death Stranding",
  "tagline": "Real Minecraft blocks in Death Stranding's world, solid for Sam to climb.",
  "description": "Build with Minecraft's blocks anywhere in Death Stranding. They sit on the real ground, hide behind its rocks and buildings, and are solid for Sam to bump into and climb. Press F6 to build, I for Minecraft's inventory, and try Minecraft arrows and TNT on MULEs and BTs (people are only knocked out). Both games run at the same time and Death Stranding blends Minecraft into its own picture.",
  "method": "passthrough",
  "tier": "unlocked",
  "testLabel": "beta",
  "games": [
    {
      "role": "host",
      "key": "death-stranding-dc",
      "name": "DEATH STRANDING DIRECTOR'S CUT",
      "store": "steam",
      "steamAppId": "1850570",
      "version": {
        "kind": "buildIds",
        "values": ["13300582"],
        "note": "Steam build 13300582. On other builds its features switch themselves off."
      }
    },
    {
      "role": "guest",
      "key": "minecraft-java",
      "name": "Minecraft: Java Edition",
      "store": "minecraft",
      "version": {
        "kind": "any",
        "note": "A Microsoft account that owns Minecraft: Java Edition. The app sets up Minecraft 26.3 itself."
      }
    }
  ],
