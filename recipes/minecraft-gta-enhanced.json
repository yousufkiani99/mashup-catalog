  "media": {},
  "aiBuilt": true,
  "knownIssues": [
    "To play as Steve, hold Left Alt (D-pad Down on a controller) for GTA's character wheel and pick Steve. Pick a GTA character to switch back. F7 also turns Steve on and off.",
    "A Minecraft window opens too and stays open behind GTA V. It draws the blocks you see in GTA, so leave it open.",
    "Story mode only. GTA starts with BattlEye off, which keeps GTA Online out; never take a modded game online.",
    "Pick Story Mode on GTA's start screen yourself.",
    "A GTA update stops it until a new Script Hook V comes out.",
    "E opens the creative inventory; Escape closes it. Escape in play opens GTA's pause menu and hides the Minecraft blocks until you go back to the game.",
    "Explosions hurt GTA's people and cars but can't dig into GTA's roads or buildings.",
    "If the Minecraft ground ends up too high or too low, press F8 to level it where you stand."
  ],
  "important": [
    {
      "text": "Script Hook V links GTA V Enhanced with Minecraft. It comes only from its author's own site, so you press Download there. We do everything else.",
      "link": "https://www.dev-c.com/gtav/scripthookv/",
      "linkLabel": "Get Script Hook V",
      "blocksInstall": true,
      "input": {
        "id": "script-hook-v-enhanced",
        "kind": "zip",
        "name": "Script Hook V",
        "label": "The Script Hook V zip",
        "mustContain": ["ScriptHookV.dll", "dinput8.dll", "xinput1_4.dll"],
        "find": {
          "folder": "downloads",
          "name": "^ScriptHookV_.*\\.zip$",
          "exclude": "DotNet"
        },
        "wrongFiles": [
          {
            "name": "_SDK_",
            "contains": ["ScriptHookV.lib", "main.h"],
            "message": "That's the Script Hook V developer kit, not Script Hook V itself. On the author's page, use the Download link just above it."
          }
        ],
        "versionCheck": {
          "file": "ScriptHookV.dll",
          "game": "gta-v-enhanced",
          "rule": "game-build-enhanced"
        },
        "origin": {
          "hosts": ["dev-c.com"]
        }
      }
    }
  ]
}
