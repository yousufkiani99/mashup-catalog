{
  "schemaVersion": 2,
  "id": "minecraft-gta-enhanced",
  "title": "Minecraft in GTA Enhanced",
  "tagline": "Play as Steve in the new GTA V: build with real Minecraft blocks, fly an elytra and blow up TNT.",
  "description": "Pick Steve from GTA's character wheel and play real Minecraft inside GTA V Enhanced. Place blocks that people and cars run into, walk and climb on what you build, light TNT and throw ender pearls, and glide over Los Santos with an elytra and firework rockets. Minecraft's mobs, arrows, fire and explosions all reach GTA's world. Press E for the full creative inventory. Pick a GTA character again to switch back. Story mode only. Both games run at the same time and GTA V blends Minecraft into its own picture.",
  "method": "passthrough",
  "tier": "unlocked",
  "testLabel": "beta",
  "games": [
    {
      "role": "host",
      "key": "gta-v-enhanced",
      "name": "Grand Theft Auto V Enhanced",
      "store": "steam",
      "steamAppId": "3240220",
      "version": {
        "kind": "exeVersions",
        "values": ["1.0.1158.16", "1.0.1158.13"],
        "note": "GTA V Enhanced (not Legacy). The creator played it on 1.0.1158.16; Script Hook V lists 1.0.1158.13. After a GTA update it waits for Script Hook V to catch up."
      }
    },
    {
      "role": "guest",
      "key": "minecraft-java",
      "name": "Minecraft: Java Edition",
      "store": "minecraft",
      "version": {
        "kind": "any",
        "note": "A Microsoft account that owns Minecraft: Java Edition. The app sets up Minecraft 26.3 itself."
      }
    }
  ],
