  "steps": [
    {
      "action": "extract",
      "input": "script-hook-v-enhanced",
      "to": "{game:gta-v-enhanced}",
      "only": ["**/ScriptHookV.dll", "**/dinput8.dll", "**/xinput1_4.dll"],
      "flatten": true
    },
    {
      "action": "extract",
      "download": "reshade-setup",
      "to": "{game:gta-v-enhanced}",
      "only": ["ReShade64.dll"],
      "rename": [
        {
          "from": "ReShade64.dll",
          "to": "ReShade64.asi"
        }
      ]
    },
    {
      "action": "copy",
      "download": "reshade-fxh",
      "to": "{game:gta-v-enhanced}/reshade-shaders/Shaders"
    },
    {
      "action": "copy",
      "download": "reshadeui-fxh",
      "to": "{game:gta-v-enhanced}/reshade-shaders/Shaders"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-enhanced}/ReShade.ini",
      "section": "GENERAL",
      "key": "EffectSearchPaths",
      "value": ".\\reshade-shaders\\Shaders\\"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-enhanced}/ReShade.ini",
      "section": "GENERAL",
      "key": "TextureSearchPaths",
      "value": ".\\reshade-shaders\\Textures\\"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-enhanced}/ReShade.ini",
      "section": "GENERAL",
      "key": "PresetPath",
      "value": ".\\ReShadePreset.ini"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-enhanced}/ReShade.ini",
      "section": "GENERAL",
      "key": "PreprocessorDefinitions",
      "value": "RESHADE_DEPTH_INPUT_IS_REVERSED=1,RESHADE_DEPTH_INPUT_IS_UPSIDE_DOWN=0,RESHADE_DEPTH_INPUT_IS_LOGARITHMIC=0,RESHADE_DEPTH_LINEARIZATION_FAR_PLANE=1000"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-enhanced}/ReShade.ini",
      "section": "OVERLAY",
      "key": "TutorialProgress",
      "value": "4"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-enhanced}/ReShade.ini",
      "section": "OVERLAY",
      "key": "ShowClock",
      "value": "0"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-enhanced}/ReShade.ini",
      "section": "OVERLAY",
      "key": "ShowFPS",
      "value": "0"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-enhanced}/ReShade.ini",
      "section": "SCREENSHOT",
      "key": "SavePath",
      "value": ".\\"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-enhanced}/ReShadePreset.ini",
      "section": "",
      "key": "Techniques",
      "value": "MCPassthrough@MCPassthrough.fx"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-enhanced}/ReShadePreset.ini",
      "section": "",
      "key": "TechniqueSorting",
      "value": "MCPassthrough@MCPassthrough.fx"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-enhanced}/ReShadePreset.ini",
      "section": "MCPassthrough.fx",
      "key": "LightMatch",
      "value": "0"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-enhanced}/ReShadePreset.ini",
      "section": "MCPassthrough.fx",
      "key": "Reproject",
      "value": "0"
    },
    {
      "action": "extract",
      "download": "minecraft-gta-enhanced",
      "to": "{game:gta-v-enhanced}"
    },
    {
      "action": "prism-instance"
    },
    {
      "action": "xml-set",
      "file": "{documents}/Rockstar Games/GTAV Enhanced/settings.xml",
      "element": "PauseOnFocusLoss",
      "attribute": "value",
      "value": "0"
    },
    {
      "action": "xml-set",
      "file": "{documents}/Rockstar Games/GTAV Enhanced/settings.xml",
      "element": "Windowed",
      "attribute": "value",
      "value": "2"
    }
  ],
  "launch": {
    "steps": [
      {
        "order": 1,
        "target": "prism",
        "waitFor": {
          "logFile": "{prism-instance}/logs/latest.log",
          "pattern": "host link listening",
          "message": "Getting Minecraft ready. The first start downloads Minecraft and takes a few minutes.",
          "timeoutSeconds": 1800
        }
      },
      {
        "order": 2,
        "target": "game",
        "gameKey": "gta-v-enhanced",
        "via": "steam",
        "args": ["-nobattleye"]
      }
    ],
    "ready": {
      "logFile": "{prism-instance}/logs/latest.log",
      "pattern": "host connected from"
    }
  },
  "saves": [
    {
      "gameKey": "gta-v-enhanced",
      "path": "{documents}/Rockstar Games/GTAV Enhanced/Profiles"
    },
    {
      "gameKey": "minecraft-java",
      "path": "{prism-instance}/saves"
    }
  ],
  "requirements": {
    "notes": "Both games render at once, so it needs a strong PC. Turn off frame generation and other temporal effects in GTA if Minecraft's edges smear. Minecraft's window stays open in the background."
  },
  "offlineOnly": true,
