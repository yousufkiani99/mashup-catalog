    "fabricApiVersion": "0.155.3+26.1.2",
    "javaMajor": 25,
    "mods": [
      "fabric-api"
    ],
    "instanceName": "SBCraft",
    "jvmArgs": [
      "--enable-native-access=ALL-UNNAMED"
    ],
    "maxMemoryMb": 3072
  },
