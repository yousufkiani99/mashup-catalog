{
  "schemaVersion": 5,
  "id": "sbcraft",
  "title": "SBCraft",
  "tagline": "Play FNAF: Security Breach as a Minecraft player: build, light and blow up the Pizzaplex.",
  "description": "Minecraft runs inside Five Nights at Freddy's: Security Breach. Security Breach's camera drives Minecraft's, its floors and walls become invisible blocks, and Minecraft's blocks, hotbar and explosions are drawn into the Pizzaplex, lit by its lights. Place planks, light torches and set off TNT while the animatronics hunt you. Both games run at the same time: Minecraft runs alongside and Security Breach shows its picture.",
  "method": "passthrough",
  "tier": "unlocked",
  "testLabel": "beta",
  "games": [
    {
      "role": "host",
      "key": "fnaf-security-breach",
      "name": "Five Nights at Freddy's: Security Breach",
      "store": "steam",
      "steamAppId": "747660",
      "version": {
        "kind": "any",
        "note": "Runs in DirectX 11 (the app starts it that way)."
      }
    },
    {
      "role": "guest",
      "key": "minecraft-java",
      "name": "Minecraft: Java Edition",
      "store": "minecraft",
      "version": {
        "kind": "any",
        "note": "A Microsoft account that owns Minecraft: Java Edition. The app sets up Minecraft 26.1.2 itself."
      }
    }
  ],
  "minecraft": {
