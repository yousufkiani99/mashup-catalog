  "steps": [
    {
      "action": "extract",
      "download": "ue4ss",
      "to": "{game:fnaf-security-breach}/fnaf9/Binaries/Win64",
      "only": [
        "dwmapi.dll",
        "UE4SS.dll",
        "UE4SS-settings.ini",
        "Mods/**"
      ]
    },
    {
      "action": "ini-set",
      "file": "{game:fnaf-security-breach}/fnaf9/Binaries/Win64/UE4SS-settings.ini",
      "section": "Debug",
      "key": "GuiConsoleEnabled",
      "value": "0"
    },
    {
      "action": "extract",
      "download": "sbcraft",
      "to": "{game:fnaf-security-breach}/fnaf9/Binaries/Win64/Mods/SBCraft",
      "from": "SBCraft-Installer-0.1.0/files/sb/Mods/SBCraft"
    },
    {
      "action": "mkdir",
      "path": "{game:fnaf-security-breach}/fnaf9/Binaries/Win64/Mods/SBCraft/link"
    },
    {
      "action": "run",
      "download": "reshade-setup",
      "args": [
        "{exe:fnaf-security-breach}",
        "--api",
        "dxgi",
        "--headless"
      ],
      "waitForExit": true,
      "note": "Installs ReShade (the version with add-on support) into the game as dxgi.dll. Nothing shows on screen."
    },
    {
      "action": "ini-set",
      "file": "{game:fnaf-security-breach}/fnaf9/Binaries/Win64/ReShade.ini",
      "section": "GENERAL",
      "key": "EffectSearchPaths",
      "value": ".\\reshade-shaders\\Shaders\\"
    },
    {
      "action": "ini-set",
      "file": "{game:fnaf-security-breach}/fnaf9/Binaries/Win64/ReShade.ini",
      "section": "GENERAL",
      "key": "TextureSearchPaths",
      "value": ".\\reshade-shaders\\Textures\\"
    },
    {
      "action": "ini-set",
      "file": "{game:fnaf-security-breach}/fnaf9/Binaries/Win64/ReShade.ini",
      "section": "GENERAL",
      "key": "PresetPath",
      "value": ".\\ReShadePreset.ini"
    },
    {
      "action": "ini-set",
      "file": "{game:fnaf-security-breach}/fnaf9/Binaries/Win64/ReShade.ini",
      "section": "GENERAL",
      "key": "PreprocessorDefinitions",
      "value": "RESHADE_DEPTH_INPUT_IS_REVERSED=1,RESHADE_DEPTH_INPUT_IS_UPSIDE_DOWN=0,RESHADE_DEPTH_INPUT_IS_LOGARITHMIC=0,RESHADE_DEPTH_LINEARIZATION_FAR_PLANE=1000"
    },
    {
      "action": "ini-set",
      "file": "{game:fnaf-security-breach}/fnaf9/Binaries/Win64/ReShade.ini",
      "section": "ADDON",
      "key": "AddonPath",
      "value": ".\\"
    },
    {
      "action": "ini-set",
      "file": "{game:fnaf-security-breach}/fnaf9/Binaries/Win64/ReShade.ini",
      "section": "OVERLAY",
      "key": "TutorialProgress",
      "value": "4"
    },
    {
      "action": "ini-set",
      "file": "{game:fnaf-security-breach}/fnaf9/Binaries/Win64/ReShade.ini",
      "section": "OVERLAY",
      "key": "ShowClock",
      "value": "0"
    },
    {
      "action": "ini-set",
      "file": "{game:fnaf-security-breach}/fnaf9/Binaries/Win64/ReShade.ini",
      "section": "OVERLAY",
      "key": "ShowFPS",
      "value": "0"
    },
    {
      "action": "ini-set",
      "file": "{game:fnaf-security-breach}/fnaf9/Binaries/Win64/ReShadePreset.ini",
      "section": "",
      "key": "Techniques",
      "value": "SBCraft@SBCraft.fx"
    },
    {
      "action": "ini-set",
      "file": "{game:fnaf-security-breach}/fnaf9/Binaries/Win64/ReShadePreset.ini",
      "section": "",
      "key": "TechniqueSorting",
      "value": "SBCraft@SBCraft.fx"
    },
    {
      "action": "copy",
      "download": "reshade-fxh",
      "to": "{game:fnaf-security-breach}/fnaf9/Binaries/Win64/reshade-shaders/Shaders"
    },
    {
      "action": "copy",
      "download": "reshadeui-fxh",
      "to": "{game:fnaf-security-breach}/fnaf9/Binaries/Win64/reshade-shaders/Shaders"
    },
    {
      "action": "extract",
      "download": "sbcraft",
      "to": "{game:fnaf-security-breach}/fnaf9/Binaries/Win64",
      "from": "SBCraft-Installer-0.1.0/files",
      "only": [
        "SBCraft.addon64"
      ]
    },
    {
      "action": "extract",
      "download": "sbcraft",
      "to": "{game:fnaf-security-breach}/fnaf9/Binaries/Win64/reshade-shaders/Shaders",
      "from": "SBCraft-Installer-0.1.0/files/sb/reshade-shaders/Shaders",
      "only": [
        "SBCraft.fx"
      ]
    },
    {
      "action": "prism-instance"
    },
    {
      "action": "extract",
      "download": "sbcraft",
      "to": "{prism-instance}/mods",
      "from": "SBCraft-Installer-0.1.0/files",
      "only": [
        "sbcraft-0.1.0.jar"
      ]
    }
  ],
  "launch": {
    "steps": [
      {
        "order": 1,
        "target": "prism",
        "waitFor": {
          "logFile": "{prism-instance}/logs/latest.log",
          "pattern": "host link listening on 127.0.0.1",
          "message": "Getting Minecraft ready. The first start downloads Minecraft and takes a few minutes.",
          "timeoutSeconds": 1800
        }
      },
      {
        "order": 2,
        "target": "game",
        "gameKey": "fnaf-security-breach",
        "via": "steam",
        "args": [
          "-dx11",
          "-windowed"
        ]
      }
    ],
    "ready": {
      "logFile": "{prism-instance}/logs/latest.log",
      "pattern": "host connected from",
      "message": "Starting Security Breach in DirectX 11 and linking it to Minecraft. Load your save when it opens.",
      "timeoutSeconds": 900
    }
  },
  "saves": [
    {
      "gameKey": "fnaf-security-breach",
      "path": "{localappdata}/fnaf9/Saved/SaveGames"
    },
    {
      "gameKey": "minecraft-java",
      "path": "{prism-instance}/saves"
    }
  ],
  "requirements": {
    "ramGb": 3,
    "notes": "About 3 GB of extra RAM for Minecraft. Security Breach runs in DirectX 11."
  },
