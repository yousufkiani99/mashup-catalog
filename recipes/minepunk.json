{
  "schemaVersion": 1,
  "id": "minepunk",
  "title": "Minepunk",
  "tagline": "Real Minecraft inside Cyberpunk 2077: Steve replaces V in Night City.",
  "description": "Steve replaces V, and Minecraft's items work in Night City. Ender pearls teleport you, even off buildings. The sword hits and launches people, arrows hurt them, and TNT, creepers and fireworks set off real Cyberpunk explosions. Glide over Japantown with an elytra and stand on the blocks you build. V's health and Steve's hearts are the same, so damage in either game shows in both. Both games run at the same time and Cyberpunk blends Minecraft into its own picture.",
  "method": "passthrough",
  "tier": "unlocked",
  "testLabel": "beta",
  "games": [
    {
      "role": "host",
      "key": "cyberpunk-2077",
      "name": "Cyberpunk 2077",
      "store": "steam",
      "steamAppId": "1091500",
      "version": {
        "kind": "any",
        "note": "Needs game version 2.31 (base game; Phantom Liberty wasn't tested). Other versions need matching mod updates first."
      }
    },
    {
      "role": "guest",
      "key": "minecraft-java",
      "name": "Minecraft: Java Edition",
      "store": "minecraft",
      "version": {
        "kind": "any",
        "note": "A Microsoft account that owns Minecraft: Java Edition. The app sets up Minecraft 26.3 itself."
      }
    }
  ],
