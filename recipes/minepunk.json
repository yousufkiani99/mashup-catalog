  "steps": [
    { "action": "extract", "download": "cyber-engine-tweaks", "to": "{game:cyberpunk-2077}" },
    { "action": "extract", "download": "red4ext", "to": "{game:cyberpunk-2077}" },
    { "action": "extract", "download": "redscript", "to": "{game:cyberpunk-2077}" },
    { "action": "extract", "download": "codeware", "to": "{game:cyberpunk-2077}" },
    {
      "action": "extract",
      "download": "world-builder",
      "to": "{game:cyberpunk-2077}",
      "only": ["archive/pc/mod/baseEntity.archive"]
    },
    {
      "action": "run",
      "download": "reshade-setup",
      "args": ["{exe:cyberpunk-2077}", "--api", "dxgi", "--headless"],
      "waitForExit": true,
      "note": "Installs ReShade (the version with add-on support) into Cyberpunk as dxgi.dll. Nothing shows on screen."
    },
    {
      "action": "ini-set",
      "file": "{game:cyberpunk-2077}/bin/x64/ReShade.ini",
      "section": "GENERAL",
      "key": "PreprocessorDefinitions",
      "value": "RESHADE_DEPTH_INPUT_IS_REVERSED=1,RESHADE_DEPTH_INPUT_IS_UPSIDE_DOWN=0,RESHADE_DEPTH_INPUT_IS_LOGARITHMIC=0"
    },
    {
      "action": "ini-set",
      "file": "{game:cyberpunk-2077}/bin/x64/ReShadePreset.ini",
      "section": "",
      "key": "Techniques",
      "value": "MCPassthrough@MCPassthrough.fx"
    },
    {
      "action": "ini-set",
      "file": "{game:cyberpunk-2077}/bin/x64/ReShadePreset.ini",
      "section": "",
      "key": "TechniqueSorting",
      "value": "MCPassthrough@MCPassthrough.fx"
    },
    {
      "action": "copy",
      "download": "reshade-fxh",
      "to": "{game:cyberpunk-2077}/bin/x64/reshade-shaders/Shaders"
    },
    {
      "action": "copy",
      "download": "reshadeui-fxh",
      "to": "{game:cyberpunk-2077}/bin/x64/reshade-shaders/Shaders"
    },
    { "action": "extract", "download": "minepunk", "to": "{game:cyberpunk-2077}" },
    { "action": "prism-instance" }
  ],
  "launch": {
    "steps": [
      {
        "order": 1,
        "target": "prism",
        "waitFor": {
          "logFile": "{prism-instance}/logs/latest.log",
          "pattern": "Backend library: LWJGL|Sound engine started|Error starting SoundSystem",
          "message": "Getting Minecraft ready. The first start downloads Minecraft and takes a few minutes.",
          "timeoutSeconds": 1800
        }
      },
      {
        "order": 2,
        "target": "game",
        "gameKey": "cyberpunk-2077",
        "via": "steam",
        "args": ["--launcher-skip", "-borderless"]
      }
    ],
    "ready": {
      "logFile": "{prism-instance}/logs/latest.log",
      "pattern": "host connected from"
    }
  },
  "saves": [
    { "gameKey": "cyberpunk-2077", "path": "{savedgames}/CD Projekt Red/Cyberpunk 2077" },
    { "gameKey": "minecraft-java", "path": "{prism-instance}/saves" }
  ],
  "requirements": {
    "notes": "Both games render at once, so it needs a strong PC. Borderless windowed works best. Minecraft's window stays open in the background."
  },
