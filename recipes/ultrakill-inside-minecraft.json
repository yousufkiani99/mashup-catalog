    "manualInstall": "https://github.com/xandermodsstuff-dot/ultrakill-minecraft/blob/v0.1.2/README.md#installing"
  },
  "media": {},
  "aiBuilt": true,
  "knownIssues": [
    "Play in Minecraft's window. ULTRAKILL's window stays open behind it: don't minimize or close it. If ULTRAKILL's window comes to the front, click back into Minecraft's.",
    "ULTRAKILL's colour palette, dithering and vignette effects don't show in the picture.",
    "Not supported yet: the Elytra, riding (boats, horses, minecarts) and shields.",
    "Single-player only.",
    "Killcraft and ULTRAKILL inside Minecraft can't be installed at the same time, because both load into ULTRAKILL."
  ],
  "important": [
    {
      "text": "Before you install, start ULTRAKILL from Steam as usual and play its tutorial until you have the Revolver (the first pistol). ULTRAKILL inside Minecraft needs a save that has it."
    }
  ]
}
