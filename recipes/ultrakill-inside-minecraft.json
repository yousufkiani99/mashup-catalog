{
  "schemaVersion": 2,
  "id": "ultrakill-inside-minecraft",
  "title": "ULTRAKILL inside Minecraft",
  "tagline": "Play a Minecraft world as V1: ULTRAKILL's moves, guns, arms and parry against Minecraft's mobs.",
  "description": "Become V1 in a normal Minecraft world. The real ULTRAKILL runs hidden next to Minecraft and supplies the movement, the weapons, the arms and the HUD, while Minecraft supplies the world, the blocks and the mobs. Dash, slide, slam and wall-jump on Minecraft's blocks; every ULTRAKILL weapon hurts Minecraft's mobs, and you can parry their attacks. Explosions break blocks, the Jackhammer mines, and Tab puts Minecraft items in V1's blue hand. Press F7 to switch between V1 and plain Steve. Your ULTRAKILL save is never changed.",
  "method": "passthrough",
  "tier": "unlocked",
  "testLabel": "beta",
  "games": [
    {
      "role": "host",
      "key": "ultrakill",
      "name": "ULTRAKILL",
      "store": "steam",
      "steamAppId": "1229490",
      "version": {
        "kind": "any",
        "note": "Any current Steam version (its creator tested the October 2026 one)."
      }
    },
    {
      "role": "guest",
      "key": "minecraft-java",
      "name": "Minecraft: Java Edition",
      "store": "minecraft",
      "version": {
        "kind": "any",
        "note": "A Microsoft account that owns Minecraft: Java Edition. The app sets up Minecraft 26.3 itself."
      }
    }
  ],
  "minecraft": {
    "gameVersion": "26.3",
    "loader": "fabric",
    "loaderVersion": "0.19.5",
    "fabricApiVersion": "0.161.0+26.3",
    "javaMajor": 25,
    "mods": ["ukpassthrough-mc", "fabric-api"],
    "instanceName": "ULTRAKILL inside Minecraft",
    "maxMemoryMb": 4096
  },
  "downloads": [
