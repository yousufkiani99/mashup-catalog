  "steps": [
    { "action": "extract", "download": "bepinex", "to": "{game:ultrakill}" },
    {
      "action": "copy",
      "download": "ukpassthrough-plugin",
      "to": "{game:ultrakill}/BepInEx/plugins/UKPassthrough"
    },
    { "action": "prism-instance" }
  ],
  "launch": {
    "steps": [
      {
        "order": 1,
        "target": "prism",
        "waitFor": {
          "logFile": "{prism-instance}/logs/latest.log",
          "pattern": "Backend library: LWJGL|Sound engine started|Error starting SoundSystem",
          "message": "Getting Minecraft ready. The first start downloads Minecraft and takes a few minutes.",
          "timeoutSeconds": 1800
        }
      },
      { "order": 2, "target": "game", "gameKey": "ultrakill", "via": "steam" }
    ],
    "ready": {
      "logFile": "{game:ultrakill}/BepInEx/LogOutput.log",
      "pattern": "connected to Minecraft on",
      "message": "Open or create a single-player world in Minecraft. V1 drops in once ULTRAKILL connects.",
      "timeoutSeconds": 1800
    }
  },
  "saves": [
    { "gameKey": "ultrakill", "path": "{game:ultrakill}/Saves" },
    { "gameKey": "minecraft-java", "path": "{prism-instance}/saves" }
  ],
  "requirements": {
    "ramGb": 3,
    "notes": "About 3 GB of extra RAM for Minecraft, about 1.5 GB of disk for Minecraft's files, and a graphics card that runs Minecraft 26.3. Both games draw at once: on a slower PC, turn on Potato Mode (Esc, then ULTRAKILL x Minecraft Settings)."
  },
  "conflictsWith": ["killcraft", "ultracraft"],
