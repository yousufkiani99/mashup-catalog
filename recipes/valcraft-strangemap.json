{
  "schemaVersion": 3,
  "id": "valcraft-strangemap",
  "title": "ValCraft (strangemap)",
  "tagline": "Real Minecraft drawn into Valheim: build, mine and fight trolls as a Minecraft player in Valheim's world.",
  "description": "Real Minecraft runs next to Valheim and is painted into Valheim's own picture. Explore Valheim as a Minecraft player: build and break blocks that Valheim's creatures bump into, fight trolls with Minecraft swords, bows, TNT and ender pearls, mine rocks and dig the ground with pickaxes and fell trees with axes. Press R to switch between Minecraft's hands and your Viking's own weapons, and F5 to see yourself. Fly in creative, or play survival where Valheim's hits land on Minecraft's hearts. Minecraft runs hidden on your own account, with your name and skin. A different mashup from LoAlCo's ValCraft.",
  "method": "passthrough",
  "tier": "unlocked",
  "testLabel": "beta",
  "games": [
    {
      "role": "host",
      "key": "valheim",
      "name": "Valheim",
      "store": "steam",
      "steamAppId": "892970",
      "version": {
        "kind": "any",
        "note": "Any current Steam version. It runs on DirectX 11 for this mashup."
      }
    },
    {
      "role": "guest",
      "key": "minecraft-java",
      "name": "Minecraft: Java Edition",
      "store": "minecraft",
      "version": {
        "kind": "any",
        "note": "A Microsoft account that owns Minecraft: Java Edition. The app sets up Minecraft 26.3 itself."
      }
    }
  ],
  "minecraft": {
    "gameVersion": "26.3",
    "loader": "fabric",
