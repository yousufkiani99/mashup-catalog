    "mods": ["fabric-api"],
    "instanceName": "ValCraft strangemap",
    "jvmArgs": ["--enable-native-access=ALL-UNNAMED", "-Dpassthrough.startHidden=true"],
    "maxMemoryMb": 4096
  },
