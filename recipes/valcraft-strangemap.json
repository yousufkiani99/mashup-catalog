  "steps": [
    {
      "action": "extract",
      "download": "bepinexpack-valheim",
      "to": "{game:valheim}",
      "from": "BepInExPack_Valheim"
    },
    {
      "action": "run",
      "download": "reshade-setup",
      "args": ["{exe:valheim}", "--api", "dxgi", "--headless"],
      "waitForExit": true,
      "note": "Installs ReShade (the version with add-on support) into Valheim as dxgi.dll. Nothing shows on screen."
    },
    {
      "action": "ini-set",
      "file": "{game:valheim}/ReShade.ini",
      "section": "GENERAL",
      "key": "EffectSearchPaths",
      "value": ".\\reshade-shaders\\Shaders\\"
    },
    {
      "action": "ini-set",
      "file": "{game:valheim}/ReShade.ini",
      "section": "GENERAL",
      "key": "TextureSearchPaths",
      "value": ".\\reshade-shaders\\Textures\\"
    },
    {
      "action": "ini-set",
      "file": "{game:valheim}/ReShade.ini",
      "section": "GENERAL",
      "key": "PresetPath",
      "value": ".\\ReShadePreset.ini"
    },
    {
      "action": "ini-set",
      "file": "{game:valheim}/ReShade.ini",
      "section": "GENERAL",
      "key": "PreprocessorDefinitions",
      "value": "RESHADE_DEPTH_INPUT_IS_REVERSED=1,RESHADE_DEPTH_INPUT_IS_UPSIDE_DOWN=0,RESHADE_DEPTH_INPUT_IS_LOGARITHMIC=0,RESHADE_DEPTH_LINEARIZATION_FAR_PLANE=1000"
    },
    {
      "action": "ini-set",
      "file": "{game:valheim}/ReShade.ini",
      "section": "ADDON",
      "key": "AddonPath",
      "value": ".\\"
    },
    {
      "action": "ini-set",
      "file": "{game:valheim}/ReShade.ini",
      "section": "OVERLAY",
      "key": "TutorialProgress",
      "value": "4"
    },
    {
      "action": "ini-set",
      "file": "{game:valheim}/ReShade.ini",
      "section": "OVERLAY",
      "key": "ShowClock",
      "value": "0"
    },
    {
      "action": "ini-set",
      "file": "{game:valheim}/ReShade.ini",
      "section": "OVERLAY",
      "key": "ShowFPS",
      "value": "0"
    },
    {
      "action": "ini-set",
      "file": "{game:valheim}/ReShadePreset.ini",
      "section": "",
      "key": "Techniques",
      "value": "MCPassthrough@MCPassthrough.fx"
    },
    {
      "action": "ini-set",
      "file": "{game:valheim}/ReShadePreset.ini",
      "section": "",
      "key": "TechniqueSorting",
      "value": "MCPassthrough@MCPassthrough.fx"
    },
    {
      "action": "copy",
      "download": "reshade-fxh",
      "to": "{game:valheim}/reshade-shaders/Shaders"
    },
    {
      "action": "copy",
      "download": "reshadeui-fxh",
      "to": "{game:valheim}/reshade-shaders/Shaders"
    },
    {
      "action": "extract",
      "download": "valcraft-strangemap",
      "to": "{game:valheim}",
      "from": "files",
      "only": ["ValCraft.addon64"]
    },
    {
      "action": "extract",
      "download": "valcraft-strangemap",
      "to": "{game:valheim}/reshade-shaders/Shaders",
      "from": "files",
      "only": ["MCPassthrough.fx"]
    },
    {
      "action": "extract",
      "download": "valcraft-strangemap",
      "to": "{game:valheim}/BepInEx/plugins",
      "from": "files",
      "only": ["ValCraft.dll"]
    },
    {
      "action": "ini-set",
      "file": "{game:valheim}/BepInEx/config/valcraft.passthrough.cfg",
      "section": "Minecraft",
      "key": "AutoStart",
      "value": "false"
    },
    { "action": "prism-instance" },
    {
      "action": "extract",
      "download": "valcraft-strangemap",
      "to": "{prism-instance}/mods",
      "from": "files",
      "only": ["valcraft-mc.jar"]
    }
  ],
  "launch": {
    "steps": [
      { "order": 1, "target": "prism" },
      {
        "order": 2,
        "target": "game",
        "gameKey": "valheim",
        "via": "steam",
        "args": ["-force-d3d11"]
      }
    ],
    "ready": {
      "logFile": "{game:valheim}/BepInEx/LogOutput.log",
      "pattern": "connected to Minecraft",
      "message": "Starting Valheim and linking it to Minecraft. If Steam asks how to start Valheim, pick the normal option, not Vulkan.",
      "timeoutSeconds": 1200
    }
  },
  "saves": [
    { "gameKey": "valheim", "path": "{locallow}/IronGate/Valheim" },
    { "gameKey": "minecraft-java", "path": "{prism-instance}/saves" }
  ],
  "requirements": {
    "ramGb": 3,
    "notes": "About 3 GB of extra RAM for Minecraft, about 1.5 GB of disk for Minecraft's files, and a graphics card that runs Valheim on DirectX 11."
  },
