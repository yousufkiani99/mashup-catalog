{
  "schemaVersion": 5,
  "id": "eldencraft",
  "title": "EldenCraft",
  "tagline": "Minecraft in the Lands Between: shops, bosses, Torrent as a horse and the Nether.",
  "description": "Play Elden Ring as a Minecraft player in a dedicated world: progress from wood to netherite across the bosses, buy from rune shops, ride Torrent as a Minecraft horse and travel to the Nether. Both games run at once and Elden Ring draws Minecraft into its own picture. Elden Ring runs offline on its own EldenCraft save, copied from your normal save the first time; your normal save is never changed.",
  "method": "passthrough",
  "tier": "unlocked",
  "testLabel": "beta",
  "offlineOnly": true,
  "games": [
    {
      "role": "host",
      "key": "elden-ring",
      "name": "ELDEN RING",
      "store": "steam",
      "steamAppId": "1245620",
      "version": {
        "kind": "exeVersions",
        "values": [
          "2.7.2.0"
        ],
        "note": "Needs Elden Ring 1.17.2 (eldenring.exe 2.7.2.0), the Steam version since 2026-10-20."
      }
    },
    {
      "role": "guest",
      "key": "minecraft-java",
      "name": "Minecraft: Java Edition",
      "store": "minecraft",
      "version": {
        "kind": "any",
        "note": "A Microsoft account that owns Minecraft: Java Edition. The app sets up Minecraft 26.3 itself."
      }
    }
  ],
  "minecraft": {
    "gameVersion": "26.3",
    "loader": "fabric",
    "loaderVersion": "0.19.5",
    "fabricApiVersion": "0.161.0+26.3",
    "javaMajor": 25,
    "mods": [
      "fabric-api"
    ],
    "instanceName": "EldenCraft",
    "jvmArgs": [
      "--enable-native-access=ALL-UNNAMED",
      "-Djava.net.preferIPv4Stack=true"
    ],
    "maxMemoryMb": 4096
  },
  "downloads": [
    {
      "id": "eldencraft",
      "name": "EldenCraft 0.26.0",
      "url": "https://github.com/SocketByte/EldenCraft/releases/download/v0.26.0/EldenCraft-0.26.0-windows-x64.zip",
      "sha256": "3e25b7cf169143bd385d53fc9c542439e4a243005cc6a26c942412a5e7f1298f",
      "sizeBytes": 7818816,
      "kind": "mashup",
      "source": "github-release",
      "licence": "MIT",
      "fileName": "EldenCraft-0.26.0-windows-x64.zip"
    },
    {
      "id": "me3",
      "name": "Mod Engine 3 (me3) 0.13.0",
      "url": "https://github.com/garyttierney/me3/releases/download/v0.13.0/me3-windows-amd64.zip",
      "sha256": "a8b693c574106f20532ab1e8b58b2452f37370679b938a884fe75f87f9b68c2b",
      "sizeBytes": 7402971,
      "kind": "loader",
      "source": "github-release",
      "licence": "MIT OR Apache-2.0",
      "fileName": "me3-windows-amd64.zip",
      "pins": {
        "version": "0.13.0",
        "fileSha256": [
          "203a726ab40ecac6ee9deaba1aa96f741d87e12def549cdeb48f99e5fe16d52d"
        ]
      }
    },
    {
      "id": "reshade-setup",
      "name": "ReShade 6.8.0 with full add-on support",
      "url": "https://reshade.me/downloads/ReShade_Setup_6.8.0_Addon.exe",
      "sha256": "afe4c8f13048306307983b8b3d41d5bf00a86820440b0e57dea10950e1176445",
      "kind": "loader",
      "source": "official-site",
      "licence": "ReShade: free; binaries are downloaded from reshade.me only",
      "fileName": "ReShade_Setup_6.8.0_Addon.exe",
      "pins": {
        "version": "6.8.0",
        "fileSha256": [
          "0cee63f9c9f13f3ac909c5b4903f4dbb4b719a7ab3b4f13b0deaf83c814b94f7"
        ]
      }
    },
    {
      "id": "prism-launcher",
      "name": "Prism Launcher 11.1.1 (portable)",
      "url": "https://github.com/PrismLauncher/PrismLauncher/releases/download/11.1.1/PrismLauncher-Windows-MSVC-Portable-11.1.1.zip",
      "sha256": "ab35a770fb06d89d2ccc098079db5db329fb4e68f42b72babd8b095efde3d2d7",
      "sizeBytes": 20396629,
      "kind": "tool",
      "source": "github-release",
      "licence": "GPL-3.0-only",
      "fileName": "PrismLauncher-Windows-MSVC-Portable-11.1.1.zip"
    },
    {
      "id": "fabric-api",
      "name": "Fabric API 0.161.0 for Minecraft 26.3",
      "url": "https://github.com/FabricMC/fabric/releases/download/0.161.0%2B26.3/fabric-api-0.161.0%2B26.3.jar",
      "sha256": "86f16178a3cecc887a85a4cfe9a79d92fa7341d8f39b5951a4d6ad800ab657a6",
      "sizeBytes": 2620967,
      "kind": "dependency",
      "source": "github-release",
      "licence": "Apache-2.0",
      "fileName": "fabric-api-0.161.0+26.3.jar"
    }
  ],
  "steps": [
    {
      "action": "extract",
      "download": "eldencraft",
      "to": "{appdir}/eldencraft/runtime",
      "from": "payload",
      "only": [
        "eldencraft_native.dll",
        "eldencraft_core.dll",
        "addons/EldenCraftCompositor.addon64",
        "shaders/EldenCraftPassthrough.fx",
        "EldenCraftPreset.ini"
      ]
    },
    {
      "action": "extract",
      "download": "eldencraft",
      "to": "{appdir}/eldencraft/data",
      "from": "config",
      "only": [
        "campaign.json"
      ]
    },
    {
      "action": "extract",
      "download": "reshade-setup",
      "to": "{appdir}/eldencraft/runtime",
      "only": [
        "ReShade64.dll"
      ],
      "rename": [
        {
          "from": "ReShade64.dll",
          "to": "ReShade64.asi"
        }
      ]
    },
    {
      "action": "extract",
      "download": "me3",
      "to": "{appdir}/eldencraft/me3",
      "only": [
        "bin/**",
        "LICENSE-MIT",
        "LICENSE-APACHE"
      ]
    },
    {
      "action": "mkdir",
      "path": "{appdir}/eldencraft/runtime/data/campaign"
    },
    {
      "action": "mkdir",
      "path": "{appdir}/eldencraft/runtime/logs"
    },
    {
      "action": "ini-set",
      "file": "{appdir}/eldencraft/runtime/ReShade.ini",
      "section": "ADDON",
      "key": "AddonPath",
      "value": "{appdir}/eldencraft/runtime/addons"
    },
    {
      "action": "ini-set",
      "file": "{appdir}/eldencraft/runtime/ReShade.ini",
      "section": "GENERAL",
      "key": "EffectSearchPaths",
      "value": "{appdir}/eldencraft/runtime/shaders"
    },
    {
      "action": "ini-set",
      "file": "{appdir}/eldencraft/runtime/ReShade.ini",
      "section": "GENERAL",
      "key": "PresetPath",
      "value": "{appdir}/eldencraft/runtime/EldenCraftPreset.ini"
    },
    {
      "action": "ini-set",
      "file": "{appdir}/eldencraft/runtime/ReShade.ini",
      "section": "INPUT",
      "key": "InputProcessing",
      "value": "2"
    },
    {
      "action": "ini-set",
      "file": "{appdir}/eldencraft/runtime/ReShade.ini",
      "section": "OVERLAY",
      "key": "TutorialProgress",
      "value": "4"
    },
    {
      "action": "prism-instance"
    },
    {
      "action": "extract",
      "download": "eldencraft",
      "to": "{prism-instance}/mods",
      "only": [
        "payload/eldencraft-bridge.jar"
      ],
      "flatten": true
    },
    {
      "action": "write-file",
      "path": "{prism-instance}/config/eldencraft-campaign-link.json",
      "lines": [
        "{{",
        "  \"config\": \"{appdir}/eldencraft/data/campaign.json\",",
        "  \"directory\": \"{appdir}/eldencraft/runtime/data/campaign\"",
        "}}"
      ],
      "lineEnding": "lf",
      "escape": "json"
    }
  ],
  "launch": {
    "steps": [
      {
        "order": 1,
        "target": "prism",
        "env": {
          "ELDENCRAFT_DATA_DIR": "{appdir}/eldencraft/runtime/data",
          "ELDENCRAFT_CAMPAIGN_CONFIG": "{appdir}/eldencraft/data/campaign.json",
          "ELDENCRAFT_CAMPAIGN_DIR": "{appdir}/eldencraft/runtime/data/campaign",
          "ELDENCRAFT_EXPECTED_SHA256": "f9118fea2cfd8fa3901e8060bfadb1552cb2471771ded8a5b662c4e298ffb328",
          "RESHADE_BASE_PATH_OVERRIDE": "{appdir}/eldencraft/runtime",
          "ELDENCRAFT_MELEE_LAB": "1",
          "ELDENCRAFT_NATIVE_COLLIDERS": "1",
          "ELDENCRAFT_NATIVE_MOBS": "1",
          "ELDENCRAFT_GPU_TRANSPORT": "1"
        },
        "waitFor": {
          "logFile": "{prism-instance}/logs/latest.log",
          "pattern": "Backend library: LWJGL|Sound engine started|Error starting SoundSystem",
          "message": "Getting Minecraft ready. The first start downloads Minecraft and takes a few minutes.",
          "timeoutSeconds": 1800
        }
      },
      {
        "order": 2,
        "target": "game",
        "gameKey": "elden-ring",
        "via": "loader",
        "exe": "{game:elden-ring}/Game/eldenring.exe",
        "env": {
          "ELDENCRAFT_DATA_DIR": "{appdir}/eldencraft/runtime/data",
          "ELDENCRAFT_CAMPAIGN_CONFIG": "{appdir}/eldencraft/data/campaign.json",
          "ELDENCRAFT_CAMPAIGN_DIR": "{appdir}/eldencraft/runtime/data/campaign",
          "ELDENCRAFT_EXPECTED_SHA256": "f9118fea2cfd8fa3901e8060bfadb1552cb2471771ded8a5b662c4e298ffb328",
          "RESHADE_BASE_PATH_OVERRIDE": "{appdir}/eldencraft/runtime",
          "ELDENCRAFT_MELEE_LAB": "1",
          "ELDENCRAFT_NATIVE_COLLIDERS": "1",
          "ELDENCRAFT_NATIVE_MOBS": "1",
          "ELDENCRAFT_GPU_TRANSPORT": "1"
        }
      }
    ]
  },
  "saves": [
    {
      "gameKey": "elden-ring",
      "path": "{appdata}/EldenRing"
    },
    {
      "gameKey": "minecraft-java",
      "path": "{prism-instance}/saves"
    }
  ],
  "requirements": {
    "ramGb": 4,
    "notes": "Both games run at once, so it needs a strong PC (DirectX 12, Windows 10 2004 or newer). Keep Steam open."
  },
  "credits": [
    {
      "name": "SocketByte",
      "role": "Creator of EldenCraft",
      "url": "https://github.com/SocketByte"
    },
    {
      "name": "garyttierney and me3 contributors",
      "role": "Mod Engine 3, which starts Elden Ring with the mashup",
      "url": "https://github.com/garyttierney/me3"
    },
    {
      "name": "crosire",
      "role": "ReShade and its add-on API",
      "url": "https://reshade.me"
    }
  ],
  "licence": {
    "spdx": "MIT",
    "url": "https://github.com/SocketByte/EldenCraft/blob/main/LICENSE",
    "permission": "not-needed"
  },
  "links": {
    "source": "https://github.com/SocketByte/EldenCraft",
    "manualInstall": "https://github.com/SocketByte/EldenCraft#readme"
  },
  "media": {},
  "aiBuilt": false,
  "knownIssues": [
    "Only Elden Ring 1.17.2 works. After a game update the mashup stays off until EldenCraft catches up.",
    "Offline only: Elden Ring runs without its online features while you play this.",
    "EldenCraft uses its own Minecraft world; Minecraft Ring worlds stay where they are."
  ],
  "loaderOptions": {
    "me3": {
      "game": "eldenring",
      "dir": "{appdir}/eldencraft/me3",
      "profile": "{appdir}/eldencraft/runtime/eldencraft.me3",
      "natives": [
        "{appdir}/eldencraft/runtime/ReShade64.asi",
        "{appdir}/eldencraft/runtime/eldencraft_native.dll"
      ],
      "savefile": "EldenCraft.sl2",
      "skipSteamInit": true,
      "memPatch": false
    }
  }
}
