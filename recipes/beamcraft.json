{
  "schemaVersion": 2,
  "id": "beamcraft",
  "title": "BeamCraft",
  "tagline": "Step out of your car as Steve: build, fight and get run over in BeamNG.drive's world.",
  "description": "Get out of any car and you are Steve, walking around BeamNG.drive's maps with Minecraft's movement, items and inventory. Blocks you place become real objects that cars crash into, punching a car dents it, TNT damages cars nearby, and getting run over hurts. Boats float on BeamNG's seas, and Minecraft's lighting follows BeamNG's time of day. Every map gets its own patch of the Minecraft world, so builds never overlap. Both games run at the same time: Minecraft runs hidden and BeamNG.drive shows everything.",
  "method": "passthrough",
  "tier": "unlocked",
  "testLabel": "beta",
  "games": [
    {
      "role": "host",
      "key": "beamng-drive",
      "name": "BeamNG.drive",
      "store": "steam",
      "steamAppId": "284160",
      "version": {
        "kind": "any",
        "note": "Tested on BeamNG.drive 0.39. Needs 0.37 or newer (the version that moved BeamNG's mods folder)."
      }
    },
    {
      "role": "guest",
      "key": "minecraft-java",
      "name": "Minecraft: Java Edition",
      "store": "minecraft",
      "version": {
        "kind": "any",
        "note": "A Microsoft account that owns Minecraft: Java Edition. The app sets up Minecraft 1.21.1 itself."
      }
    }
  ],
  "minecraft": {
    "gameVersion": "1.21.1",
    "loader": "fabric",
    "loaderVersion": "0.19.5",
    "fabricApiVersion": "0.116.17+1.21.1",
    "javaMajor": 21,
    "mods": ["beamcraft-fabric", "fabric-api-1-21-1"],
    "instanceName": "BeamCraft",
    "maxMemoryMb": 4096
  },
  "downloads": [
    {
      "id": "beamcraft",
      "name": "BeamCraft 0.1.0 (BeamNG.drive side)",
      "url": "https://github.com/DJtsdk/BeamCraft/releases/download/v0.1.0/beamcraft.zip",
      "sha256": "db1d05f5d7dbb803b7b52f0f262354e5e8293a1387e30b965ec6b07cdfcded6a",
      "sizeBytes": 102636,
      "kind": "mashup",
