  "steps": [
    {
      "action": "extract",
      "download": "bepinex",
      "to": "{game:ultrakill}"
    },
    {
      "action": "extract",
      "download": "ultracraft",
      "to": "{game:ultrakill}/BepInEx/plugins/UltraBridge",
      "only": ["UltraBridge.dll"]
    },
    { "action": "prism-instance" },
    {
      "action": "extract",
      "download": "ultracraft",
      "to": "{prism-instance}/mods",
      "only": ["ultracraft-0.1.8+1.21.11.jar"]
    }
  ],
  "launch": {
    "steps": [{ "order": 1, "target": "prism" }],
    "ready": {
      "logFile": "{game:ultrakill}/BepInEx/LogOutput.log",
      "pattern": "Minecraft connected",
      "message": "Minecraft starts ULTRAKILL by itself. If Steam asks to allow ULTRAKILL's launch options, click Continue.",
      "timeoutSeconds": 1800
    }
  },
  "saves": [
    { "gameKey": "ultrakill", "path": "{game:ultrakill}/Saves" },
    { "gameKey": "minecraft-java", "path": "{prism-instance}/saves" }
  ],
  "requirements": {
    "ramGb": 3,
    "notes": "Two games draw at once on one graphics card. If it's slow, lower ULTRAKILL's resolution to 540p in Minecraft's Ultracraft settings and keep Minecraft's render distance at 8 to 12 chunks."
