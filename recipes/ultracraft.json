{
  "schemaVersion": 2,
  "id": "ultracraft",
  "title": "Ultracraft",
  "tagline": "Play the real ULTRAKILL inside Minecraft: become V1 and fight its enemies and bosses in Minecraft's world.",
  "description": "Become V1 inside Minecraft 1.21.11. The real ULTRAKILL runs alongside and is drawn into Minecraft's window, while Minecraft's blocks and mobs become its world and enemies. Fight ULTRAKILL's enemies across Minecraft's biomes, beat bosses in arenas themed after each layer of Hell, spend P at a shop you craft, play the Cyber Grind and team up with friends on your home network. Press F8 to switch between V1 and Steve. Your own ULTRAKILL save is never changed.",
  "method": "passthrough",
  "tier": "unlocked",
  "testLabel": "beta",
  "games": [
    {
      "role": "host",
      "key": "ultrakill",
      "name": "ULTRAKILL",
      "store": "steam",
      "steamAppId": "1229490",
      "version": { "kind": "any", "note": "Any current Steam version." }
    },
    {
      "role": "guest",
      "key": "minecraft-java",
      "name": "Minecraft: Java Edition",
      "store": "minecraft",
      "version": {
        "kind": "any",
        "note": "A Microsoft account that owns Minecraft: Java Edition. The app sets up Minecraft 1.21.11 itself."
      }
    }
  ],
  "minecraft": {
