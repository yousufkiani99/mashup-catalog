{
  "schemaVersion": 1,
  "id": "minecraft-gta-v",
  "title": "Minecraft x GTA V",
  "tagline": "Real Minecraft in Los Santos: build walls that stop traffic, blow up TNT and fly an elytra.",
  "description": "Build with Minecraft blocks in Los Santos: people and cars stop at your walls. TNT and creepers blow up in both games, crossbow fireworks burst as GTA rockets, a sword swing sends people flying and an ender pearl moves your player. Glide over the city with an elytra, set Minecraft's mobs on the police, or light a Nether portal and watch the streets turn to the Nether. Story mode only. Both games run at the same time and GTA V blends Minecraft into its own picture.",
  "method": "passthrough",
  "tier": "free",
  "testLabel": "beta",
  "games": [
    {
      "role": "host",
      "key": "gta-v-legacy",
      "name": "Grand Theft Auto V Legacy",
      "store": "steam",
      "steamAppId": "271590",
      "version": {
        "kind": "exeVersions",
        "values": ["1.0.3889.0"],
        "note": "GTA V Legacy (not Enhanced), tested on game build 3889. After a GTA update it waits for Script Hook V to catch up."
      }
    },
    {
      "role": "guest",
      "key": "minecraft-java",
      "name": "Minecraft: Java Edition",
      "store": "minecraft",
      "version": {
        "kind": "any",
        "note": "A Microsoft account that owns Minecraft: Java Edition. The app sets up Minecraft 26.3 itself."
      }
    }
  ],
  "minecraft": {
    "gameVersion": "26.3",
    "loader": "fabric",
    "loaderVersion": "0.19.5",
    "fabricApiVersion": "0.161.0+26.3",
    "javaMajor": 25,
    "mods": ["minecraft-gta5-fabric", "fabric-api"],
    "instanceName": "Minecraft x GTA V"
  },
  "downloads": [
    {
      "id": "minecraft-gta5",
      "name": "Minecraft x GTA V 0.1.0 (GTA side, community build)",
      "url": "https://github.com/yousufkiani99/minecraft-gta5-builds/releases/download/v0.1.0/minecraft-gta5-0.1.0.zip",
      "sha256": "4ab5c8c53aac656d84e8a5d4f11934f3a318c066a9e9b6d9309ecf8ff95b234f",
      "kind": "mashup",
      "source": "github-release",
      "licence": "MIT",
      "fileName": "minecraft-gta5-0.1.0.zip"
    },
    {
      "id": "minecraft-gta5-fabric",
      "name": "Minecraft x GTA V 0.1.0 (Minecraft side, community build)",
      "url": "https://github.com/yousufkiani99/minecraft-gta5-builds/releases/download/v0.1.0/minecraft-gta5-fabric-0.1.0.jar",
      "sha256": "0f879781e01997f7174957b23f2842283fd40bcf7ca7115cd8652aabe8190914",
      "kind": "mashup",
      "source": "github-release",
      "licence": "MIT",
      "fileName": "minecraft-gta5-fabric-0.1.0.jar"
    },
    {
      "id": "reshade-setup",
      "name": "ReShade 6.8.0 with full add-on support",
      "url": "https://reshade.me/downloads/ReShade_Setup_6.8.0_Addon.exe",
      "sha256": "afe4c8f13048306307983b8b3d41d5bf00a86820440b0e57dea10950e1176445",
      "kind": "loader",
      "source": "official-site",
      "licence": "ReShade: free; binaries are downloaded from reshade.me only",
      "fileName": "ReShade_Setup_6.8.0_Addon.exe",
      "pins": { "version": "6.8.0" }
    },
    {
      "id": "reshade-fxh",
      "name": "ReShade.fxh (ReShade shader include)",
      "url": "https://raw.githubusercontent.com/crosire/reshade-shaders/slim/Shaders/ReShade.fxh",
      "sha256": "6dabfbbaf968c3871905d2ea17f96572ff7b1cec01310b5d0e5252b66b30174f",
      "sizeBytes": 4250,
      "kind": "dependency",
      "source": "official-site",
      "licence": "CC0-1.0",
      "fileName": "ReShade.fxh"
    },
    {
      "id": "reshadeui-fxh",
      "name": "ReShadeUI.fxh (ReShade shader include)",
      "url": "https://raw.githubusercontent.com/crosire/reshade-shaders/slim/Shaders/ReShadeUI.fxh",
      "sha256": "78adf672df47460297eb9fe6dd238d2aafa24510b52b84feb1a745dff70eb901",
      "sizeBytes": 9930,
      "kind": "dependency",
      "source": "official-site",
      "licence": "crosire/reshade-shaders (no licence file; fetched from the official repository)",
      "fileName": "ReShadeUI.fxh"
    },
    {
      "id": "prism-launcher",
      "name": "Prism Launcher 11.1.1 (portable)",
      "url": "https://github.com/PrismLauncher/PrismLauncher/releases/download/11.1.1/PrismLauncher-Windows-MSVC-Portable-11.1.1.zip",
      "sha256": "ab35a770fb06d89d2ccc098079db5db329fb4e68f42b72babd8b095efde3d2d7",
      "sizeBytes": 20396629,
      "kind": "tool",
      "source": "github-release",
      "licence": "GPL-3.0-only",
      "fileName": "PrismLauncher-Windows-MSVC-Portable-11.1.1.zip"
    },
    {
      "id": "fabric-api",
      "name": "Fabric API 0.161.0 for Minecraft 26.3",
      "url": "https://github.com/FabricMC/fabric/releases/download/0.161.0%2B26.3/fabric-api-0.161.0%2B26.3.jar",
      "sha256": "86f16178a3cecc887a85a4cfe9a79d92fa7341d8f39b5951a4d6ad800ab657a6",
      "sizeBytes": 2620967,
      "kind": "dependency",
      "source": "github-release",
      "licence": "Apache-2.0",
      "fileName": "fabric-api-0.161.0+26.3.jar"
    }
  ],
  "steps": [
    {
      "action": "extract",
      "input": "script-hook-v",
      "to": "{game:gta-v-legacy}",
      "only": ["**/ScriptHookV.dll", "**/dinput8.dll"],
      "flatten": true
    },
    {
      "action": "extract",
      "download": "reshade-setup",
      "to": "{game:gta-v-legacy}",
      "only": ["ReShade64.dll"],
      "rename": [{ "from": "ReShade64.dll", "to": "ReShade64.asi" }]
    },
    {
      "action": "copy",
      "download": "reshade-fxh",
      "to": "{game:gta-v-legacy}/reshade-shaders/Shaders"
    },
    {
      "action": "copy",
      "download": "reshadeui-fxh",
      "to": "{game:gta-v-legacy}/reshade-shaders/Shaders"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-legacy}/ReShade.ini",
      "section": "GENERAL",
      "key": "EffectSearchPaths",
      "value": ".\\reshade-shaders\\Shaders\\"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-legacy}/ReShade.ini",
      "section": "GENERAL",
      "key": "TextureSearchPaths",
      "value": ".\\reshade-shaders\\Textures\\"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-legacy}/ReShade.ini",
      "section": "GENERAL",
      "key": "PresetPath",
      "value": ".\\ReShadePreset.ini"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-legacy}/ReShade.ini",
      "section": "GENERAL",
      "key": "PreprocessorDefinitions",
      "value": "RESHADE_DEPTH_INPUT_IS_REVERSED=1,RESHADE_DEPTH_INPUT_IS_UPSIDE_DOWN=0,RESHADE_DEPTH_INPUT_IS_LOGARITHMIC=0,RESHADE_DEPTH_LINEARIZATION_FAR_PLANE=1000"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-legacy}/ReShade.ini",
      "section": "OVERLAY",
      "key": "TutorialProgress",
      "value": "4"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-legacy}/ReShade.ini",
      "section": "OVERLAY",
      "key": "ShowClock",
      "value": "0"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-legacy}/ReShade.ini",
      "section": "OVERLAY",
      "key": "ShowFPS",
      "value": "0"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-legacy}/ReShade.ini",
      "section": "SCREENSHOT",
      "key": "SavePath",
      "value": ".\\"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-legacy}/ReShadePreset.ini",
      "section": "",
      "key": "Techniques",
      "value": "MCPassthrough@MCPassthrough.fx"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-legacy}/ReShadePreset.ini",
      "section": "",
      "key": "TechniqueSorting",
      "value": "MCPassthrough@MCPassthrough.fx"
    },
    { "action": "extract", "download": "minecraft-gta5", "to": "{game:gta-v-legacy}" },
    { "action": "prism-instance" }
  ],
  "launch": {
    "steps": [
      {
        "order": 1,
        "target": "prism",
        "waitFor": {
          "logFile": "{prism-instance}/logs/latest.log",
          "pattern": "host link listening",
          "message": "Getting Minecraft ready. The first start downloads Minecraft and takes a few minutes.",
          "timeoutSeconds": 1800
        }
      },
      {
        "order": 2,
        "target": "game",
        "gameKey": "gta-v-legacy",
        "via": "steam",
        "args": ["-nobattleye"]
      }
    ],
    "ready": {
      "logFile": "{prism-instance}/logs/latest.log",
      "pattern": "host connected from"
    }
  },
  "saves": [
    { "gameKey": "gta-v-legacy", "path": "{documents}/Rockstar Games/GTA V/Profiles" },
    { "gameKey": "minecraft-java", "path": "{prism-instance}/saves" }
  ],
  "requirements": {
    "notes": "Both games render at once, so it needs a strong PC. GTA runs best windowed with Pause on focus loss, depth of field and heavy post effects off. Minecraft's window stays open in the background."
  },
  "offlineOnly": true,
  "credits": [
    {
      "name": "Rehan and universal-modder contributors",
      "role": "Creators of the Minecraft x GTA V passthrough",
      "url": "https://github.com/rehan-remade/universal-modder"
    },
    {
      "name": "Alexander Blade",
      "role": "Script Hook V and its ASI loader",
      "url": "https://www.dev-c.com/gtav/scripthookv/"
    },
    { "name": "crosire", "role": "ReShade and its add-on API", "url": "https://reshade.me" }
  ],
  "licence": {
    "spdx": "MIT",
    "url": "https://github.com/rehan-remade/universal-modder/blob/main/LICENSE",
    "permission": "pending"
  },
  "links": {
    "source": "https://github.com/rehan-remade/universal-modder/tree/main/examples/minecraft-gta5-passthrough",
    "manualInstall": "https://github.com/rehan-remade/universal-modder/tree/main/examples/minecraft-gta5-passthrough#build-install-run"
  },
  "media": {},
  "aiBuilt": true,
  "knownIssues": [
    "You play as Steve: GTA's own character is hidden and Steve stands in his place.",
    "A Minecraft window opens too and stays open behind GTA V. It draws the blocks you see in GTA, so leave it open.",
    "Story mode only. GTA starts with BattlEye off, which keeps GTA Online out; never take a modded game online.",
    "Pick Story Mode on GTA's start screen yourself.",
    "A GTA update stops it until a new Script Hook V comes out.",
    "At most 400 placed blocks become solid in GTA."
  ],
  "important": [
    {
      "text": "Script Hook V links GTA V with Minecraft. It comes only from its author's own site, so you press Download there. We do everything else.",
      "link": "https://www.dev-c.com/gtav/scripthookv/",
      "linkLabel": "Get Script Hook V",
      "blocksInstall": true,
      "input": {
        "id": "script-hook-v",
        "kind": "zip",
        "name": "Script Hook V",
        "label": "The Script Hook V zip",
        "mustContain": ["ScriptHookV.dll", "dinput8.dll"],
        "find": { "folder": "downloads", "name": "^ScriptHookV_.*\\.zip$", "exclude": "DotNet" },
        "wrongFiles": [
          {
            "name": "_SDK_",
            "contains": ["ScriptHookV.lib", "main.h"],
            "message": "That's the Script Hook V developer kit, not Script Hook V itself. On the author's page, use the Download link just above it."
          }
        ],
        "versionCheck": { "file": "ScriptHookV.dll", "game": "gta-v-legacy", "rule": "game-build" },
        "origin": { "hosts": ["dev-c.com"] }
      }
    }
  ]
}
