  },
  "links": {
    "source": "https://github.com/rehan-remade/universal-modder/tree/main/examples/minecraft-gta5-passthrough",
    "manualInstall": "https://github.com/rehan-remade/universal-modder/tree/main/examples/minecraft-gta5-passthrough#build-install-run"
  },
  "media": {},
  "aiBuilt": true,
  "knownIssues": [
    "Waiting for a ready-made build: it installs once its download is published.",
    "Story mode only. GTA starts with BattlEye off, which keeps GTA Online out; never take a modded game online.",
    "Pick Story Mode on GTA's start screen yourself.",
    "A GTA update stops it until a new Script Hook V comes out.",
    "At most 400 placed blocks become solid in GTA."
  ],
  "important": [
    {
      "text": "Script Hook V can only be downloaded from its author's website. Download it, open the zip and copy ScriptHookV.dll and dinput8.dll from its bin folder into your GTA V folder (the one with GTA5.exe). Install continues once they're there.",
      "link": "https://www.dev-c.com/gtav/scripthookv/",
      "linkLabel": "Get Script Hook V",
      "blocksInstall": true
    }
  ]
}
