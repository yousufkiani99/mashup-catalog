  "steps": [
    {
      "action": "extract",
      "download": "ultimate-asi-loader",
      "to": "{game:gta-iv}",
      "only": ["dinput8.dll"]
    },
    {
      "action": "extract",
      "download": "passthrough-iv",
      "to": "{game:gta-iv}",
      "from": "GTAIV",
      "only": ["MCPassthroughIV.asi"]
    },
    { "action": "prism-instance" },
    {
      "action": "extract",
      "download": "passthrough-iv",
      "to": "{prism-instance}/mods",
      "from": "Minecraft/mods",
      "only": ["*.jar"]
    }
  ],
  "launch": {
    "steps": [
      { "order": 1, "target": "prism" },
      {
        "order": 2,
        "target": "game",
        "gameKey": "gta-iv",
        "via": "steam",
        "args": ["-windowed"]
      }
    ]
  },
  "saves": [
    { "gameKey": "gta-iv", "path": "{localappdata}/Rockstar Games/GTA IV/savegames" },
    { "gameKey": "minecraft-java", "path": "{prism-instance}/saves" }
  ],
  "requirements": {
    "notes": "Both games run at once in windowed or borderless mode. Minecraft's window stays open in the background."
  },
