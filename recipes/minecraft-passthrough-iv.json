  "id": "minecraft-passthrough-iv",
  "title": "Minecraft PassthroughIV",
  "tagline": "Real Minecraft inside GTA IV: build, blow things up and fly an elytra over Liberty City.",
  "description": "Play as Steve in Liberty City, in first or third person. Build with Minecraft blocks that stop GTA's people and cars, set off TNT that explodes in both games, fight GTA's characters with Minecraft weapons and glide over the city with an elytra. Light a Nether portal and the streets around it turn into the Nether. Health is shared between both games. Both games run at the same time and GTA IV draws Minecraft into its own picture.",
  "method": "passthrough",
  "tier": "unlocked",
  "testLabel": "beta",
  "games": [
    {
      "role": "host",
      "key": "gta-iv",
      "name": "Grand Theft Auto IV: The Complete Edition",
      "store": "steam",
      "steamAppId": "12210",
      "version": {
        "kind": "exeVersions",
        "values": ["1.2.0.59"],
        "note": "The Complete Edition, version 1.2.0.59. Older 1.0 copies aren't supported."
      }
    },
    {
      "role": "guest",
      "key": "minecraft-java",
      "name": "Minecraft: Java Edition",
      "store": "minecraft",
      "version": {
        "kind": "any",
        "note": "A Microsoft account that owns Minecraft: Java Edition. The app sets up Minecraft 26.3 itself."
      }
    }
  ],
