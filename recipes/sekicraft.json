{
  "schemaVersion": 5,
  "id": "sekicraft",
  "title": "SekiCraft",
  "tagline": "Play Sekiro as a Minecraft player: dig, build and fight in Ashina.",
  "description": "A real Minecraft player in Sekiro's world: Minecraft's moves, blocks and combat, with Sekiro's own collision. Both games run at once. Sekiro runs offline. Draft: needs our build copy (D11) first.",
  "method": "passthrough",
  "tier": "unlocked",
  "testLabel": "beta",
  "games": [
    {
      "role": "host",
      "key": "sekiro",
      "name": "Sekiro: Shadows Die Twice",
      "store": "steam",
      "steamAppId": "814380",
      "version": {
        "kind": "any",
        "note": "Made for Sekiro 1.06, the current Steam version."
      }
    },
    {
      "role": "guest",
      "key": "minecraft-java",
      "name": "Minecraft: Java Edition",
      "store": "minecraft",
      "version": {
        "kind": "any",
        "note": "A Microsoft account that owns Minecraft: Java Edition. The app sets up Minecraft 26.3 itself."
      }
    }
  ],
  "minecraft": {
    "gameVersion": "26.3",
    "loader": "fabric",
    "loaderVersion": "0.19.5",
    "fabricApiVersion": "0.161.0+26.3",
    "javaMajor": 25,
    "mods": [
      "sekicraft-fabric",
      "fabric-api"
    ],
    "instanceName": "SekiCraft",
    "jvmArgs": [
      "--enable-native-access=ALL-UNNAMED",
      "-Dsekicraft.startHidden=true"
    ],
    "maxMemoryMb": 4096
  },
  "downloads": [
    {
      "id": "sekicraft",
      "name": "SekiCraft 0.0.1 (Sekiro side, community build)",
      "url": "https://github.com/yousufkiani99/mashup-builds/releases/download/sekicraft-v0.0.1/sekicraft-0.0.1-dlls.zip",
      "sha256": "2c3451800de6ac649aa51d024a7a9ae9ff0567629c65d459a8cb01c0eca54574",
      "kind": "mashup",
      "source": "github-release",
      "licence": "MIT",
      "fileName": "sekicraft-0.0.1-dlls.zip",
      "sizeBytes": 310647
    },
    {
      "id": "sekicraft-fabric",
      "name": "SekiCraft 0.0.1 (Minecraft side, community build)",
      "url": "https://github.com/yousufkiani99/mashup-builds/releases/download/sekicraft-v0.0.1/sekicraft-0.0.1.jar",
      "sha256": "f4443cc0f6844feb94e5df31ede58e5facc96c09d6889a77b09a18e00a51b57e",
      "kind": "mashup",
      "source": "github-release",
      "licence": "MIT",
      "fileName": "sekicraft-0.0.1.jar",
      "sizeBytes": 249837
    },
    {
      "id": "me3",
      "name": "Mod Engine 3 (me3) 0.13.0",
      "url": "https://github.com/garyttierney/me3/releases/download/v0.13.0/me3-windows-amd64.zip",
      "sha256": "a8b693c574106f20532ab1e8b58b2452f37370679b938a884fe75f87f9b68c2b",
      "sizeBytes": 7402971,
      "kind": "loader",
      "source": "github-release",
      "licence": "MIT OR Apache-2.0",
      "fileName": "me3-windows-amd64.zip",
      "pins": {
        "version": "0.13.0",
        "fileSha256": [
          "203a726ab40ecac6ee9deaba1aa96f741d87e12def549cdeb48f99e5fe16d52d"
        ]
      }
    },
    {
      "id": "prism-launcher",
      "name": "Prism Launcher 11.1.1 (portable)",
      "url": "https://github.com/PrismLauncher/PrismLauncher/releases/download/11.1.1/PrismLauncher-Windows-MSVC-Portable-11.1.1.zip",
      "sha256": "ab35a770fb06d89d2ccc098079db5db329fb4e68f42b72babd8b095efde3d2d7",
      "sizeBytes": 20396629,
      "kind": "tool",
      "source": "github-release",
      "licence": "GPL-3.0-only",
      "fileName": "PrismLauncher-Windows-MSVC-Portable-11.1.1.zip"
    },
    {
      "id": "fabric-api",
      "name": "Fabric API 0.161.0 for Minecraft 26.3",
      "url": "https://github.com/FabricMC/fabric/releases/download/0.161.0%2B26.3/fabric-api-0.161.0%2B26.3.jar",
      "sha256": "86f16178a3cecc887a85a4cfe9a79d92fa7341d8f39b5951a4d6ad800ab657a6",
      "sizeBytes": 2620967,
      "kind": "dependency",
      "source": "github-release",
      "licence": "Apache-2.0",
      "fileName": "fabric-api-0.161.0+26.3.jar"
    }
  ],
  "steps": [
    {
      "action": "extract",
      "download": "sekicraft",
      "to": "{appdir}/sekicraft",
      "only": [
        "sekicraft.dll",
        "sekicraft_core.dll",
        "LICENSE.txt",
        "LICENSE-SkyCraft.txt",
        "NOTICE.txt"
      ],
      "stripTopFolder": true
    },
    {
      "action": "ini-set",
      "file": "{appdir}/sekicraft/sekicraft.ini",
      "section": "",
      "key": "minecraft_command",
      "value": ""
    },
    {
      "action": "extract",
      "download": "me3",
      "to": "{appdir}/sekicraft/me3",
      "only": [
        "bin/**",
        "LICENSE-MIT",
        "LICENSE-APACHE"
      ]
    },
    {
      "action": "prism-instance"
    }
  ],
  "launch": {
    "steps": [
      {
        "order": 1,
        "target": "prism",
        "waitFor": {
          "logFile": "{prism-instance}/logs/latest.log",
          "pattern": "Backend library: LWJGL|Sound engine started|Error starting SoundSystem",
          "message": "Getting Minecraft ready. The first start downloads Minecraft and takes a few minutes.",
          "timeoutSeconds": 1800
        }
      },
      {
        "order": 2,
        "target": "game",
        "gameKey": "sekiro",
        "via": "loader",
        "exe": "{game:sekiro}/sekiro.exe"
      }
    ],
    "ready": {
      "logFile": "{prism-instance}/logs/latest.log",
      "pattern": "SekiCraft: linked to"
    }
  },
  "saves": [
    {
      "gameKey": "sekiro",
      "path": "{appdata}/Sekiro"
    },
    {
      "gameKey": "minecraft-java",
      "path": "{prism-instance}/saves"
    }
  ],
  "requirements": {
    "ramGb": 4,
    "notes": "Both games run at once, so it needs a strong PC (DirectX 12, Windows 10 2004 or newer). Keep Steam open."
  },
  "credits": [
    {
      "name": "NIHKOOL",
      "role": "Creator of SekiCraft",
      "url": "https://github.com/NIHKOOL"
    },
    {
      "name": "chasmlol",
      "role": "SkyCraft, whose Minecraft side SekiCraft builds on",
      "url": "https://github.com/chasmlol"
    }
  ],
  "licence": {
    "spdx": "MIT",
    "url": "https://github.com/NIHKOOL/SekiCraft/blob/main/LICENSE",
    "permission": "not-needed"
  },
  "links": {
    "source": "https://github.com/NIHKOOL/SekiCraft",
    "manualInstall": "https://github.com/NIHKOOL/SekiCraft#readme"
  },
  "media": {},
  "aiBuilt": false,
  "knownIssues": [
    "Offline only.",
    "Sekiro's anti-tamper protection is switched off in memory while you play this (nothing on disk changes)."
  ],
  "loaderOptions": {
    "me3": {
      "game": "sekiro",
      "dir": "{appdir}/sekicraft/me3",
      "profile": "{appdir}/sekicraft/sekicraft.me3",
      "natives": [
        "{appdir}/sekicraft/sekicraft.dll"
      ],
      "disableArxan": true
    }
  },
  "offlineOnly": true
}
