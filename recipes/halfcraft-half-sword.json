{
  "schemaVersion": 5,
  "id": "halfcraft-half-sword",
  "title": "HalfCraft",
  "tagline": "Bring Minecraft into Half Sword's brutal sword fights: blocks, mobs, TNT and more.",
  "description": "Fight in Half Sword's arenas as a Minecraft player. Place blocks that fighters walk around and break, ram them with pistons, set mobs on them, and hit them with swords, axes, the mace, bows, potions, fire and TNT. Fighters ride your boats and minecarts, choke in your water, burn in your lava and freeze in powder snow. Type /hs help in Minecraft's chat for every setting. Both games run at the same time and Half Sword shows Minecraft's picture.",
  "method": "passthrough",
  "tier": "unlocked",
  "testLabel": "beta",
  "games": [
    {
      "role": "host",
      "key": "half-sword",
      "name": "Half Sword",
      "store": "steam",
      "steamAppId": "2397300",
      "version": {
        "kind": "buildIds",
        "values": [
          "24185754"
        ],
        "note": "Made for Early Access 0.6.1.5 (Steam build 24185754). A Half Sword update can stop it until the mod catches up."
      }
    },
    {
      "role": "guest",
      "key": "minecraft-java",
      "name": "Minecraft: Java Edition",
      "store": "minecraft",
      "version": {
        "kind": "any",
        "note": "A Microsoft account that owns Minecraft: Java Edition. The app sets up Minecraft 26.3 itself."
      }
    }
  ],
  "minecraft": {
    "gameVersion": "26.3",
    "loader": "fabric",
    "loaderVersion": "0.19.5",
    "fabricApiVersion": "0.161.0+26.3",
    "javaMajor": 25,
    "mods": [
      "fabric-api"
    ],
    "instanceName": "HalfCraft",
    "jvmArgs": [
      "--enable-native-access=ALL-UNNAMED"
    ],
    "maxMemoryMb": 4096
  },
  "downloads": [
    {
      "id": "halfcraft",
      "name": "HalfCraft 1.4",
      "url": "https://github.com/Deez-coder/halfcraft/releases/download/1.4/HalfCraft-beta.zip",
      "sha256": "ad032c65d9b5bae0f2432ae0b9f7b013aa4aef51fc0d6649986e65837e768638",
      "sizeBytes": 482809,
      "kind": "mashup",
      "source": "github-release",
      "licence": "MIT",
      "fileName": "HalfCraft-beta.zip"
    },
    {
      "id": "reshade-setup",
      "name": "ReShade 6.8.0 with full add-on support",
      "url": "https://reshade.me/downloads/ReShade_Setup_6.8.0_Addon.exe",
      "sha256": "afe4c8f13048306307983b8b3d41d5bf00a86820440b0e57dea10950e1176445",
      "kind": "loader",
      "source": "official-site",
      "licence": "ReShade: free; binaries are downloaded from reshade.me only",
      "fileName": "ReShade_Setup_6.8.0_Addon.exe",
      "pins": {
        "version": "6.8.0",
        "fileSha256": [
          "0cee63f9c9f13f3ac909c5b4903f4dbb4b719a7ab3b4f13b0deaf83c814b94f7"
        ]
      }
    },
    {
      "id": "reshade-fxh",
      "name": "ReShade.fxh (ReShade shader include)",
      "url": "https://raw.githubusercontent.com/crosire/reshade-shaders/fd0022170615ce0d8162d219bff07232fa6dd84f/Shaders/ReShade.fxh",
      "sha256": "6dabfbbaf968c3871905d2ea17f96572ff7b1cec01310b5d0e5252b66b30174f",
      "sizeBytes": 4250,
      "kind": "dependency",
      "source": "official-site",
      "licence": "CC0-1.0",
      "fileName": "ReShade.fxh"
    },
    {
      "id": "reshadeui-fxh",
      "name": "ReShadeUI.fxh (ReShade shader include)",
      "url": "https://raw.githubusercontent.com/crosire/reshade-shaders/fd0022170615ce0d8162d219bff07232fa6dd84f/Shaders/ReShadeUI.fxh",
      "sha256": "78adf672df47460297eb9fe6dd238d2aafa24510b52b84feb1a745dff70eb901",
      "sizeBytes": 9930,
      "kind": "dependency",
      "source": "official-site",
      "licence": "crosire/reshade-shaders (no licence file; fetched from the official repository)",
      "fileName": "ReShadeUI.fxh"
    },
    {
      "id": "prism-launcher",
      "name": "Prism Launcher 11.1.1 (portable)",
      "url": "https://github.com/PrismLauncher/PrismLauncher/releases/download/11.1.1/PrismLauncher-Windows-MSVC-Portable-11.1.1.zip",
      "sha256": "ab35a770fb06d89d2ccc098079db5db329fb4e68f42b72babd8b095efde3d2d7",
      "sizeBytes": 20396629,
      "kind": "tool",
      "source": "github-release",
      "licence": "GPL-3.0-only",
      "fileName": "PrismLauncher-Windows-MSVC-Portable-11.1.1.zip"
    },
    {
      "id": "fabric-api",
      "name": "Fabric API 0.161.0 for Minecraft 26.3",
      "url": "https://github.com/FabricMC/fabric/releases/download/0.161.0%2B26.3/fabric-api-0.161.0%2B26.3.jar",
      "sha256": "86f16178a3cecc887a85a4cfe9a79d92fa7341d8f39b5951a4d6ad800ab657a6",
      "sizeBytes": 2620967,
      "kind": "dependency",
      "source": "github-release",
      "licence": "Apache-2.0",
      "fileName": "fabric-api-0.161.0+26.3.jar"
    }
  ],
  "steps": [
    {
      "action": "run",
      "download": "reshade-setup",
      "args": [
        "{exe:half-sword}",
        "--api",
        "dxgi",
        "--headless"
      ],
      "waitForExit": true,
      "note": "Installs ReShade (the version with add-on support) into the game as dxgi.dll. Nothing shows on screen."
    },
    {
      "action": "ini-set",
      "file": "{game:half-sword}/HalfswordUE5/Binaries/Win64/ReShade.ini",
      "section": "GENERAL",
      "key": "EffectSearchPaths",
      "value": ".\\reshade-shaders\\Shaders\\"
    },
    {
      "action": "ini-set",
      "file": "{game:half-sword}/HalfswordUE5/Binaries/Win64/ReShade.ini",
      "section": "GENERAL",
      "key": "TextureSearchPaths",
      "value": ".\\reshade-shaders\\Textures\\"
    },
    {
      "action": "ini-set",
      "file": "{game:half-sword}/HalfswordUE5/Binaries/Win64/ReShade.ini",
      "section": "GENERAL",
      "key": "PresetPath",
      "value": ".\\ReShadePreset.ini"
    },
    {
      "action": "ini-set",
      "file": "{game:half-sword}/HalfswordUE5/Binaries/Win64/ReShade.ini",
      "section": "ADDON",
      "key": "AddonPath",
      "value": ".\\"
    },
    {
      "action": "ini-set",
      "file": "{game:half-sword}/HalfswordUE5/Binaries/Win64/ReShade.ini",
      "section": "OVERLAY",
      "key": "TutorialProgress",
      "value": "4"
    },
    {
      "action": "ini-set",
      "file": "{game:half-sword}/HalfswordUE5/Binaries/Win64/ReShade.ini",
      "section": "OVERLAY",
      "key": "ShowClock",
      "value": "0"
    },
    {
      "action": "ini-set",
      "file": "{game:half-sword}/HalfswordUE5/Binaries/Win64/ReShade.ini",
      "section": "OVERLAY",
      "key": "ShowFPS",
      "value": "0"
    },
    {
      "action": "ini-set",
      "file": "{game:half-sword}/HalfswordUE5/Binaries/Win64/ReShadePreset.ini",
      "section": "",
      "key": "Techniques",
      "value": "MCPassthrough@MCPassthrough.fx"
    },
    {
      "action": "ini-set",
      "file": "{game:half-sword}/HalfswordUE5/Binaries/Win64/ReShadePreset.ini",
      "section": "",
      "key": "TechniqueSorting",
      "value": "MCPassthrough@MCPassthrough.fx"
    },
    {
      "action": "copy",
      "download": "reshade-fxh",
      "to": "{game:half-sword}/HalfswordUE5/Binaries/Win64/reshade-shaders/Shaders"
    },
    {
      "action": "copy",
      "download": "reshadeui-fxh",
      "to": "{game:half-sword}/HalfswordUE5/Binaries/Win64/reshade-shaders/Shaders"
    },
    {
      "action": "extract",
      "download": "halfcraft",
      "to": "{game:half-sword}/HalfswordUE5/Binaries/Win64",
      "from": "HalfCraft-beta/HalfSword",
      "only": [
        "HSPassthrough.addon64"
      ]
    },
    {
      "action": "extract",
      "download": "halfcraft",
      "to": "{game:half-sword}/HalfswordUE5/Binaries/Win64/reshade-shaders/Shaders",
      "from": "HalfCraft-beta/HalfSword/reshade-shaders/Shaders",
      "only": [
        "MCPassthrough.fx"
      ]
    },
    {
      "action": "prism-instance"
    },
    {
      "action": "extract",
      "download": "halfcraft",
      "to": "{prism-instance}/mods",
      "from": "HalfCraft-beta/Minecraft/mods",
      "only": [
        "passthrough-0.1.0.jar"
      ]
    }
  ],
  "launch": {
    "steps": [
      {
        "order": 1,
        "target": "prism",
        "waitFor": {
          "logFile": "{prism-instance}/logs/latest.log",
          "pattern": "host link listening on 127.0.0.1",
          "message": "Getting Minecraft ready. The first start downloads Minecraft and takes a few minutes.",
          "timeoutSeconds": 1800
        }
      },
      {
        "order": 2,
        "target": "game",
        "gameKey": "half-sword",
        "via": "steam"
      }
    ],
    "ready": {
      "logFile": "{prism-instance}/logs/latest.log",
      "pattern": "host connected from",
      "message": "Starting Half Sword and linking it to Minecraft.",
      "timeoutSeconds": 900
    }
  },
  "saves": [
    {
      "gameKey": "half-sword",
      "path": "{localappdata}/HalfswordUE5/Saved/SaveGames"
    },
    {
      "gameKey": "minecraft-java",
      "path": "{prism-instance}/saves"
    }
  ],
  "requirements": {
    "ramGb": 4,
    "notes": "Both games run at once: a strong PC helps. About 4 GB of extra RAM for Minecraft."
  },
  "credits": [
    {
      "name": "holdup.lethimcook (Deez-coder)",
      "role": "Creator of HalfCraft",
      "url": "https://github.com/Deez-coder"
    },
    {
      "name": "chasmlol",
      "role": "SkyCraft, whose ground-collision idea HalfCraft uses",
      "url": "https://github.com/chasmlol/SkyCraft"
    }
  ],
  "licence": {
    "spdx": "MIT",
    "url": "https://github.com/Deez-coder/halfcraft/blob/1.4/LICENSE",
    "permission": "not-needed"
  },
  "links": {
    "source": "https://github.com/Deez-coder/halfcraft",
    "manualInstall": "https://github.com/Deez-coder/halfcraft#how-to-install"
  },
  "media": {},
  "aiBuilt": true,
  "knownIssues": [
    "Switching back to your Half Sword fighter with F9 can twist his body and sometimes kills him.",
    "Keep Minecraft's window open (don't minimise it) while you play.",
    "If you fall through Half Sword's ground, type /hs fixground in Minecraft's chat.",
    "Low frame rate? Turn frame generation off in Half Sword and type /hs balance on."
  ]
}
