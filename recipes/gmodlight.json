  "knownIssues": [
    "Single player only: keep Dying Light's co-op off (set game visibility to private) while it is installed.",
    "F2 switches between Kyle's hands and Garry's Mod's. F1 or Q opens the spawn menu, C the context menu, F7 hides everything Garry's Mod draws.",
    "Made for one Dying Light version (1.55). After a Dying Light update it stops working until GModLight is updated.",
    "Garry's Mod starts without Workshop addons.",
    "GModLight and Garry's Redemption can't be installed at the same time, because both add their own mod to Garry's Mod."
  ],
  "important": [
    {
      "text": "Keep Dying Light's co-op off while you play: set its game visibility to private and don't join or host other players."
    }
  ],
  "conflictsWith": [
    "garrys-redemption"
  ]
