      "url": "https://github.com/rehan-remade"
    },
    {
      "name": "UE4SS-RE team",
      "role": "UE4SS, the Unreal Engine mod loader",
      "url": "https://github.com/UE4SS-RE/RE-UE4SS"
    }
  ],
  "licence": {
    "spdx": "MIT",
    "url": "https://github.com/ImmortalSouull/BlockBreach/blob/v1.0.0/LICENSE",
    "permission": "not-needed"
  },
  "links": {
    "source": "https://github.com/ImmortalSouull/BlockBreach",
    "manualInstall": "https://github.com/ImmortalSouull/BlockBreach/releases/tag/v1.0.0"
  },
  "media": {},
  "aiBuilt": true,
  "knownIssues": [
    "Single player only: in multiplayer the mod switches itself off.",
    "In Minecraft's inventory you can't drag items with the mouse; click to pick up and click to put down.",
    "In build mode a block can sometimes land in the air on some maps.",
    "DirectX 11 only."
  ],
  "loaderOptions": {
    "ue4ss": {
      "gameKey": "ready-or-not",
      "binaries": "{game:ready-or-not}/ReadyOrNot/Binaries/Win64",
      "layout": "ue4ss-folder",
      "mods": [
        "RoNPassthrough"
      ],
      "creatorBuild": {
        "download": "blockbreach",
        "ue4ssDllSha256": [
          "ec7fc753303d9d76a3c090557614abb1a74551bcf5b1e1267c3623d65539f251"
        ],
        "reason": "BlockBreach's mod is built together with its own UE4SS; no official download of that build exists."
      }
    }
  }
}
