  "steps": [
    {
      "action": "run",
      "download": "reshade-setup",
      "args": [
        "{exe:ready-or-not}",
        "--api",
        "dxgi",
        "--headless"
      ],
      "waitForExit": true,
      "note": "Installs ReShade (the version with add-on support) into the game as dxgi.dll. Nothing shows on screen."
    },
    {
      "action": "ini-set",
      "file": "{game:ready-or-not}/ReadyOrNot/Binaries/Win64/ReShade.ini",
      "section": "GENERAL",
      "key": "EffectSearchPaths",
      "value": ".\\reshade-shaders\\Shaders\\**"
    },
    {
      "action": "ini-set",
      "file": "{game:ready-or-not}/ReadyOrNot/Binaries/Win64/ReShade.ini",
      "section": "GENERAL",
      "key": "TextureSearchPaths",
      "value": ".\\reshade-shaders\\Textures\\**"
    },
    {
      "action": "ini-set",
      "file": "{game:ready-or-not}/ReadyOrNot/Binaries/Win64/ReShade.ini",
      "section": "GENERAL",
      "key": "PresetPath",
      "value": ".\\ReShadePreset.ini"
    },
    {
      "action": "ini-set",
      "file": "{game:ready-or-not}/ReadyOrNot/Binaries/Win64/ReShade.ini",
      "section": "GENERAL",
      "key": "PreprocessorDefinitions",
      "value": "RESHADE_DEPTH_INPUT_IS_REVERSED=1,RESHADE_DEPTH_INPUT_IS_UPSIDE_DOWN=0,RESHADE_DEPTH_INPUT_IS_LOGARITHMIC=0,RESHADE_DEPTH_LINEARIZATION_FAR_PLANE=1000"
    },
    {
      "action": "ini-set",
      "file": "{game:ready-or-not}/ReadyOrNot/Binaries/Win64/ReShade.ini",
      "section": "ADDON",
      "key": "AddonPath",
      "value": ".\\"
    },
    {
      "action": "ini-set",
      "file": "{game:ready-or-not}/ReadyOrNot/Binaries/Win64/ReShade.ini",
      "section": "OVERLAY",
      "key": "TutorialProgress",
      "value": "4"
    },
    {
      "action": "ini-set",
      "file": "{game:ready-or-not}/ReadyOrNot/Binaries/Win64/ReShade.ini",
      "section": "OVERLAY",
      "key": "ShowClock",
      "value": "0"
    },
    {
      "action": "ini-set",
      "file": "{game:ready-or-not}/ReadyOrNot/Binaries/Win64/ReShade.ini",
      "section": "OVERLAY",
      "key": "ShowFPS",
      "value": "0"
    },
    {
      "action": "ini-set",
      "file": "{game:ready-or-not}/ReadyOrNot/Binaries/Win64/ReShadePreset.ini",
      "section": "",
      "key": "Techniques",
      "value": "MCPassthrough@MCPassthrough.fx"
    },
    {
      "action": "ini-set",
      "file": "{game:ready-or-not}/ReadyOrNot/Binaries/Win64/ReShadePreset.ini",
      "section": "",
      "key": "TechniqueSorting",
      "value": "MCPassthrough@MCPassthrough.fx"
    },
    {
      "action": "copy",
      "download": "reshade-fxh",
      "to": "{game:ready-or-not}/ReadyOrNot/Binaries/Win64/reshade-shaders/Shaders"
    },
    {
      "action": "copy",
      "download": "reshadeui-fxh",
      "to": "{game:ready-or-not}/ReadyOrNot/Binaries/Win64/reshade-shaders/Shaders"
    },
    {
      "action": "ini-set",
      "file": "{game:ready-or-not}/ReadyOrNot/Binaries/Win64/ReShade.ini",
      "section": "INPUT",
      "key": "KeyOverlay",
      "value": "36,0,0,0"
    },
    {
      "action": "extract",
      "download": "blockbreach",
      "to": "{game:ready-or-not}/ReadyOrNot/Binaries/Win64",
      "from": "ReadyOrNot/Binaries/Win64",
      "only": [
        "dwmapi.dll",
        "ue4ss/UE4SS.dll",
        "ue4ss/LICENSE",
        "ue4ss/UE4SS-settings.ini",
        "ue4ss/Mods/RoNPassthrough/dlls/main.dll",
        "reshade-shaders/Shaders/MCPassthrough.fx"
      ]
    },
    {
      "action": "prism-instance"
    },
    {
      "action": "extract",
      "download": "blockbreach",
      "to": "{prism-instance}",
      "from": "Minecraft",
      "only": [
        "options.txt",
        "mods/blockbreach-passthrough.jar"
      ]
    }
  ],
  "launch": {
    "steps": [
      {
        "order": 1,
        "target": "prism",
        "waitFor": {
          "logFile": "{prism-instance}/logs/latest.log",
          "pattern": "host link listening on 127.0.0.1",
          "message": "Getting Minecraft ready. The first start downloads Minecraft and takes a few minutes.",
          "timeoutSeconds": 1800
        }
      },
      {
        "order": 2,
        "target": "game",
        "gameKey": "ready-or-not",
        "via": "steam",
        "args": [
          "-dx11"
        ]
      }
    ],
    "ready": {
      "logFile": "{prism-instance}/logs/latest.log",
      "pattern": "host connected from",
      "message": "Starting Ready or Not in DirectX 11 and linking it to Minecraft.",
      "timeoutSeconds": 900
    }
  },
  "saves": [
    {
      "gameKey": "ready-or-not",
      "path": "{localappdata}/ReadyOrNot/Saved/SaveGames"
    },
    {
      "gameKey": "minecraft-java",
      "path": "{prism-instance}/saves"
    }
  ],
  "requirements": {
    "ramGb": 4,
    "notes": "DirectX 11 only (the app starts Ready or Not that way). About 4 GB of extra RAM for Minecraft."
  },
  "credits": [
    {
      "name": "ImmortalSouull",
      "role": "Creator of BlockBreach",
