{
  "schemaVersion": 5,
  "id": "blockbreach",
  "title": "BlockBreach",
  "tagline": "Clear Ready or Not's missions with Minecraft blocks, mobs, swords and TNT.",
  "description": "Minecraft's blocks, mobs and explosions appear inside Ready or Not's missions. Press NumPad 0 for build mode with Minecraft's hotbar and creative inventory: placed blocks are real walls you can't walk or shoot through. Arrows, swords, TNT, creepers and firework crossbows hurt Ready or Not's suspects; your guns kill Minecraft's mobs, and zombies hunt suspects, officers and you. Every map gets its own part of the Minecraft world. Single player only: the mod switches itself off in multiplayer.",
  "method": "passthrough",
  "tier": "unlocked",
  "testLabel": "beta",
  "games": [
    {
      "role": "host",
      "key": "ready-or-not",
      "name": "Ready or Not",
      "store": "steam",
      "steamAppId": "1144200",
      "version": {
        "kind": "any",
        "note": "Made for the Steam version of early October 2026, in DirectX 11. A game update can stop it until the mod catches up."
      }
    },
    {
      "role": "guest",
      "key": "minecraft-java",
      "name": "Minecraft: Java Edition",
      "store": "minecraft",
      "version": {
        "kind": "any",
        "note": "A Microsoft account that owns Minecraft: Java Edition. The app sets up Minecraft 26.3 itself."
      }
    }
  ],
  "minecraft": {
    "gameVersion": "26.3",
    "loader": "fabric",
    "loaderVersion": "0.19.5",
    "fabricApiVersion": "0.161.0+26.3",
    "javaMajor": 25,
    "mods": [
      "fabric-api"
    ],
    "instanceName": "BlockBreach",
    "jvmArgs": [
      "--enable-native-access=ALL-UNNAMED"
    ],
    "maxMemoryMb": 4096
  },
  "downloads": [
    {
      "id": "blockbreach",
      "name": "BlockBreach 1.0.0 (manual-install files)",
      "url": "https://github.com/ImmortalSouull/BlockBreach/releases/download/v1.0.0/BlockBreach-1.0.0-manual.zip",
      "sha256": "9b40c89f33e514a8f6f6ba32fadbfe05c31e12f900e0e20ca64b17644acb5dc1",
      "sizeBytes": 14062707,
      "kind": "mashup",
      "source": "github-release",
      "licence": "MIT (BlockBreach; its bundled UE4SS build is MIT too)",
      "fileName": "BlockBreach-1.0.0-manual.zip",
      "pins": {
        "fileSha256": [
          "ec7fc753303d9d76a3c090557614abb1a74551bcf5b1e1267c3623d65539f251",
          "cf440b9eb8643bb7c434acfda696aee57fd981d185dca5e57fb8dbb18f8fc1cd"
        ]
      }
    },
    {
      "id": "reshade-setup",
      "name": "ReShade 6.8.0 with full add-on support",
      "url": "https://reshade.me/downloads/ReShade_Setup_6.8.0_Addon.exe",
      "sha256": "afe4c8f13048306307983b8b3d41d5bf00a86820440b0e57dea10950e1176445",
      "kind": "loader",
      "source": "official-site",
