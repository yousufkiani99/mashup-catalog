{
  "schemaVersion": 3,
  "id": "lethalcraft",
  "title": "LethalCraft",
  "tagline": "Play Lethal Company as a Minecraft player: build, fight and carry scrap with Minecraft's hotbar.",
  "description": "Play Lethal Company as a Minecraft character, with Minecraft's movement, health, hunger, armour and hotbar. Build with Minecraft blocks on the ship, the moons and inside the facility; they're lit by Lethal Company's lights, and torches and lava light the dark halls. Fight monsters with swords, axes and bows, and carry scrap and tools in your hotbar, each with its own icon and value. Blocks built on the ship travel with it. Each Lethal Company save gets its own Minecraft world. Both games run at the same time: Minecraft runs hidden and Lethal Company draws everything.",
  "method": "passthrough",
  "tier": "unlocked",
  "testLabel": "beta",
  "games": [
    {
      "role": "host",
      "key": "lethal-company",
      "name": "Lethal Company",
      "store": "steam",
      "steamAppId": "1966720",
      "version": {
        "kind": "any",
        "note": "Built for the current Steam version (v81). A big game update can stop it until the mod catches up."
      }
    },
    {
      "role": "guest",
      "key": "minecraft-java",
      "name": "Minecraft: Java Edition",
      "store": "minecraft",
      "version": {
        "kind": "any",
        "note": "A Microsoft account that owns Minecraft: Java Edition. The app sets up Minecraft 26.3 itself."
      }
    }
  ],
  "minecraft": {
    "gameVersion": "26.3",
    "loader": "fabric",
    "loaderVersion": "0.19.5",
    "fabricApiVersion": "0.161.0+26.3",
    "javaMajor": 25,
    "mods": ["lethalcraft-fabric", "fabric-api"],
    "instanceName": "LethalCraft",
    "jvmArgs": ["--enable-native-access=ALL-UNNAMED", "-Dlethalcraft.startHidden=true"],
    "maxMemoryMb": 4096
  },
  "downloads": [
    {
      "id": "lethalcraft",
      "name": "LethalCraft 0.1.1 (Lethal Company side, community build)",
      "url": "https://github.com/yousufkiani99/mashup-builds/releases/download/lethalcraft-v0.1.1/lethalcraft-0.1.1-plugin.zip",
      "sha256": "f4106271a961fdaa349faafcf2daa2880c854262cae326a1b846c116191ed983",
      "sizeBytes": 82680,
      "kind": "mashup",
      "source": "github-release",
      "licence": "MIT",
      "fileName": "lethalcraft-0.1.1-plugin.zip"
    },
    {
      "id": "lethalcraft-fabric",
      "name": "LethalCraft 0.1.1 (Minecraft side, community build)",
      "url": "https://github.com/yousufkiani99/mashup-builds/releases/download/lethalcraft-v0.1.1/lethalcraft-0.1.1.jar",
      "sha256": "f5c62cde0074f1fad327a38537cf14ef3d16e31286f64c5bf556e9c48f72dcd1",
      "sizeBytes": 318933,
      "kind": "mashup",
      "source": "github-release",
      "licence": "MIT",
      "fileName": "lethalcraft-0.1.1.jar"
    },
    {
      "id": "bepinex",
      "name": "BepInEx 5.4.23.5 (64-bit)",
      "url": "https://github.com/BepInEx/BepInEx/releases/download/v5.4.23.5/BepInEx_win_x64_5.4.23.5.zip",
      "sha256": "82f9878551030f54657792c0740d9d51a09500eeae1fba21106b0c441e6732c4",
      "sizeBytes": 639118,
      "kind": "loader",
      "source": "github-release",
      "licence": "LGPL-2.1",
      "fileName": "BepInEx_win_x64_5.4.23.5.zip",
      "pins": { "version": "5.4.23.5" }
    },
    {
      "id": "prism-launcher",
      "name": "Prism Launcher 11.1.1 (portable)",
      "url": "https://github.com/PrismLauncher/PrismLauncher/releases/download/11.1.1/PrismLauncher-Windows-MSVC-Portable-11.1.1.zip",
      "sha256": "ab35a770fb06d89d2ccc098079db5db329fb4e68f42b72babd8b095efde3d2d7",
      "sizeBytes": 20396629,
      "kind": "tool",
      "source": "github-release",
      "licence": "GPL-3.0-only",
      "fileName": "PrismLauncher-Windows-MSVC-Portable-11.1.1.zip"
    },
    {
      "id": "fabric-api",
      "name": "Fabric API 0.161.0 for Minecraft 26.3",
      "url": "https://github.com/FabricMC/fabric/releases/download/0.161.0%2B26.3/fabric-api-0.161.0%2B26.3.jar",
      "sha256": "86f16178a3cecc887a85a4cfe9a79d92fa7341d8f39b5951a4d6ad800ab657a6",
      "sizeBytes": 2620967,
      "kind": "dependency",
      "source": "github-release",
      "licence": "Apache-2.0",
      "fileName": "fabric-api-0.161.0+26.3.jar"
    }
  ],
  "steps": [
    { "action": "extract", "download": "bepinex", "to": "{game:lethal-company}" },
    {
      "action": "extract",
      "download": "lethalcraft",
      "to": "{game:lethal-company}",
      "only": [
        "BepInEx/plugins/LethalCraft/LethalCraft.dll",
        "BepInEx/plugins/LethalCraft/LICENSE.txt",
        "BepInEx/plugins/LethalCraft/NOTICE.txt"
      ]
    },
    {
      "action": "ini-set",
      "file": "{game:lethal-company}/BepInEx/config/dev.lethalcraft.cfg",
      "section": "Minecraft",
      "key": "StartWithGame",
      "value": "false"
    },
    { "action": "prism-instance" }
  ],
  "launch": {
    "steps": [
      {
        "order": 1,
        "target": "prism",
        "waitFor": {
          "logFile": "{prism-instance}/logs/latest.log",
          "pattern": "Backend library: LWJGL|Sound engine started|Error starting SoundSystem",
          "message": "Getting Minecraft ready. The first start downloads Minecraft and takes a few minutes.",
          "timeoutSeconds": 1800
        }
      },
      { "order": 2, "target": "game", "gameKey": "lethal-company", "via": "steam" }
    ],
    "ready": {
      "logFile": "{prism-instance}/logs/latest.log",
      "pattern": "linked to Lethal Company",
      "message": "Starting Minecraft next to Lethal Company. The first time, Minecraft downloads for a few minutes.",
      "timeoutSeconds": 1800
    }
  },
  "saves": [
    { "gameKey": "lethal-company", "path": "{locallow}/ZeekerssRBLX/Lethal Company" },
    { "gameKey": "minecraft-java", "path": "{prism-instance}/saves" }
  ],
  "requirements": {
    "ramGb": 4,
    "notes": "About 4 GB of extra RAM for Minecraft, which runs hidden next to Lethal Company, and a graphics card that runs Minecraft 26.3."
  },
  "credits": [
    { "name": "ADP424", "role": "Creator of LethalCraft", "url": "https://github.com/ADP424" },
    {
      "name": "petmav and RepoCraft contributors",
      "role": "RepoCraft, the R.E.P.O. port LethalCraft is a fork of",
      "url": "https://github.com/petmav/RepoCraft"
    },
    {
      "name": "chasmlol",
      "role": "Creator of SkyCraft, whose Minecraft mod, link and design LethalCraft builds on",
      "url": "https://github.com/chasmlol/SkyCraft"
    },
    {
      "name": "BepInEx team",
      "role": "BepInEx, the Unity mod loader",
      "url": "https://github.com/BepInEx/BepInEx"
    }
  ],
  "licence": {
    "spdx": "MIT",
    "url": "https://github.com/ADP424/LethalCraft/blob/bd50e731398f7e8cf9d4bbf23adf4e0051c539e5/LICENSE",
    "permission": "not-needed"
  },
  "links": {
    "source": "https://github.com/ADP424/LethalCraft",
    "manualInstall": "https://github.com/ADP424/LethalCraft#installation"
  },
  "media": {},
  "aiBuilt": true,
  "knownIssues": [
    "Brand new and experimental: this ready-made build hasn't been played by anyone yet, so expect rough edges.",
    "Play on your own. Playing with friends isn't set up by the app yet; the creator says shared worlds are new and barely tested.",
    "Start it from the app's Play button, which starts Minecraft too. Started from Steam, Lethal Company runs without Minecraft.",
    "Blocks you leave on a moon are gone when the ship leaves, because the game makes each moon anew. Blocks on the ship stay.",
    "Monsters reacting to your blocks is very new and only lightly tested.",
    "If you use a mod manager like r2modman, its profile isn't used when you play from the app."
  ]
}
