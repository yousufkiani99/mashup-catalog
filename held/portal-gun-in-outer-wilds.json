    },
    {
      "id": "owml",
      "name": "OWML 2.16.3 (Outer Wilds Mod Loader)",
      "url": "https://github.com/ow-mods/owml/releases/download/2.16.3/OWML.zip",
      "sha256": "6aaffdc7e958fe05f8c096e1eb69a0b6241facadbef624177d7573089b9bd2ed",
      "sizeBytes": 9159084,
      "kind": "loader",
      "source": "github-release",
      "licence": "MIT",
      "fileName": "OWML-2.16.3.zip"
    }
  ],
  "steps": [
    {
      "action": "extract",
      "download": "owml",
      "to": "{appdata}/OuterWildsModManager/OWML"
    },
    {
      "action": "extract",
      "download": "portal-gun",
      "to": "{appdata}/OuterWildsModManager/OWML/Mods"
    },
    {
      "action": "extract",
      "download": "portal-gun-converter",
      "to": "{appdir}/portal-gun-in-outer-wilds",
      "from": "owpg-convert"
    },
    {
      "action": "run",
      "path": "{appdir}/portal-gun-in-outer-wilds/owpg-convert.exe",
      "args": [
        "--portal2",
        "{game:portal-2}",
        "--out",
        "{localappdata}/OWPortalGun"
      ],
      "waitForExit": true,
      "note": "Converts the portal gun's model, textures and sounds from your Portal 2 files (a second or two). Portal 2 isn't started or changed.",
      "watch": [
        "{localappdata}/OWPortalGun"
      ]
    }
  ],
  "launch": {
    "steps": [
      {
        "order": 1,
        "target": "game",
        "gameKey": "outer-wilds",
        "via": "loader",
        "exe": "{appdata}/OuterWildsModManager/OWML/OWML.Launcher.exe"
      }
    ]
  },
  "saves": [
    {
      "gameKey": "outer-wilds",
      "path": "{locallow}/Mobius Digital/Outer Wilds"
    }
  ],
  "requirements": {
    "notes": "Only Outer Wilds runs. Portal 2 must be installed on this PC."
