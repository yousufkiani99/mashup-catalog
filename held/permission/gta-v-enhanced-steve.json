  "steps": [
    {
      "action": "extract",
      "input": "script-hook-v",
      "to": "{game:gta-v-enhanced}",
      "only": [
        "**/ScriptHookV.dll",
        "**/dinput8.dll"
      ],
      "flatten": true
    },
    {
      "action": "run",
      "download": "reshade-setup",
      "args": [
        "{exe:gta-v-enhanced}",
        "--api",
        "dxgi",
        "--headless"
      ],
      "waitForExit": true,
      "note": "Installs ReShade (the version with add-on support) into GTA V Enhanced as dxgi.dll. Nothing shows on screen."
    },
    {
      "action": "copy",
      "download": "steve-passthrough-fx",
      "to": "{game:gta-v-enhanced}/reshade-shaders/Shaders"
    },
    {
      "action": "copy",
      "download": "reshade-fxh",
      "to": "{game:gta-v-enhanced}/reshade-shaders/Shaders"
    },
    {
      "action": "copy",
      "download": "reshadeui-fxh",
      "to": "{game:gta-v-enhanced}/reshade-shaders/Shaders"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-enhanced}/ReShade.ini",
      "section": "GENERAL",
      "key": "EffectSearchPaths",
      "value": ".\\reshade-shaders\\Shaders"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-enhanced}/ReShade.ini",
      "section": "GENERAL",
      "key": "PresetPath",
      "value": ".\\ReShadePreset.ini"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-enhanced}/ReShade.ini",
      "section": "GENERAL",
      "key": "StartupPresetPath",
      "value": ".\\ReShadePreset.ini"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-enhanced}/ReShade.ini",
      "section": "OVERLAY",
      "key": "TutorialProgress",
      "value": "4"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-enhanced}/ReShade.ini",
      "section": "OVERLAY",
      "key": "ShowFPS",
      "value": "0"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-enhanced}/ReShadePreset.ini",
      "section": "",
      "key": "Techniques",
      "value": "MCPassthrough@MCPassthrough.fx"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-enhanced}/ReShadePreset.ini",
      "section": "",
      "key": "TechniqueSorting",
      "value": "MCPassthrough@MCPassthrough.fx"
    },
    {
      "action": "copy",
      "download": "steve-passthrough-asi",
      "to": "{game:gta-v-enhanced}"
    },
    {
      "action": "prism-instance"
    },
    {
      "action": "xml-set",
      "file": "{documents}/Rockstar Games/GTAV Enhanced/settings.xml",
      "element": "PauseOnFocusLoss",
      "attribute": "value",
      "value": "0"
    },
    {
      "action": "xml-set",
      "file": "{documents}/Rockstar Games/GTAV Enhanced/settings.xml",
      "element": "Windowed",
      "attribute": "value",
      "value": "2"
    }
  ],
  "launch": {
    "steps": [
      {
        "order": 1,
        "target": "prism",
        "waitFor": {
          "logFile": "{prism-instance}/logs/latest.log",
          "pattern": "host link listening",
          "message": "Getting Minecraft ready. The first start downloads Minecraft and takes a few minutes.",
          "timeoutSeconds": 1800
        }
      },
      {
        "order": 2,
        "target": "game",
        "gameKey": "gta-v-enhanced",
        "via": "steam",
        "args": [
          "-nobattleye"
        ]
      }
    ],
    "ready": {
      "logFile": "{prism-instance}/logs/latest.log",
      "pattern": "host connected from"
    }
  },
  "saves": [
    {
      "gameKey": "gta-v-enhanced",
      "path": "{documents}/Rockstar Games/GTAV Enhanced/Profiles"
    },
    {
      "gameKey": "minecraft-java",
      "path": "{prism-instance}/saves"
    }
  ],
  "requirements": {
    "notes": "Both games render at once, so it needs a strong PC. GTA runs windowed with Pause on focus loss off; turn depth of field, TXAA and motion blur off in GTA's graphics settings. Minecraft's window stays open in the background."
  },
