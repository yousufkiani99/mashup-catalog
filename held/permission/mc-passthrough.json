{
  "schemaVersion": 1,
  "id": "mc-passthrough",
  "title": "Steve in Los Santos",
  "tagline": "Play GTA V's story as Steve: mine the streets, lead cars on a leash and fly an elytra over the city.",
  "description": "Steve takes the place of GTA's character everywhere, with Minecraft's movement, items, blocks and mobs. Mine GTA's walls and streets with a pickaxe and tunnel under the city, put people and cars on leads, swim in GTA's sea, glide with an elytra, and light Nether and End portals that change the streets around them. TNT, fire, lava, arrows and enchantments all work on GTA's people and cars, and GTA's police fight back. Story missions stay playable. Both games run at the same time and GTA V blends Minecraft into its own picture.",
  "method": "passthrough",
  "tier": "unlocked",
  "testLabel": "beta",
  "games": [
    {
      "role": "host",
      "key": "gta-v-legacy",
      "name": "Grand Theft Auto V Legacy",
      "store": "steam",
      "steamAppId": "271590",
      "version": {
        "kind": "exeVersions",
        "values": [
          "1.0.3889.0"
        ],
        "note": "GTA V Legacy (not Enhanced), game build 3889. After a GTA update it waits for Script Hook V to catch up."
      }
    },
    {
      "role": "guest",
      "key": "minecraft-java",
      "name": "Minecraft: Java Edition",
      "store": "minecraft",
      "version": {
        "kind": "any",
        "note": "A Microsoft account that owns Minecraft: Java Edition. The app sets up Minecraft 26.3 itself."
      }
    }
  ],
