  "steps": [
    {
      "action": "extract",
      "input": "script-hook-v",
      "to": "{game:gta-v-legacy}",
      "only": [
        "**/ScriptHookV.dll",
        "**/dinput8.dll"
      ],
      "flatten": true
    },
    {
      "action": "extract",
      "download": "reshade-setup",
      "to": "{game:gta-v-legacy}",
      "only": [
        "ReShade64.dll"
      ],
      "rename": [
        {
          "from": "ReShade64.dll",
          "to": "ReShade64.asi"
        }
      ]
    },
    {
      "action": "copy",
      "download": "mc-passthrough-fx",
      "to": "{game:gta-v-legacy}/reshade-shaders/Shaders"
    },
    {
      "action": "copy",
      "download": "reshade-fxh",
      "to": "{game:gta-v-legacy}/reshade-shaders/Shaders"
    },
    {
      "action": "copy",
      "download": "reshadeui-fxh",
      "to": "{game:gta-v-legacy}/reshade-shaders/Shaders"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-legacy}/ReShade.ini",
      "section": "GENERAL",
      "key": "EffectSearchPaths",
      "value": ".\\reshade-shaders\\Shaders\\"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-legacy}/ReShade.ini",
      "section": "GENERAL",
      "key": "TextureSearchPaths",
      "value": ".\\reshade-shaders\\Textures\\"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-legacy}/ReShade.ini",
      "section": "GENERAL",
      "key": "PresetPath",
      "value": ".\\ReShadePreset.ini"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-legacy}/ReShade.ini",
      "section": "GENERAL",
      "key": "PreprocessorDefinitions",
      "value": "RESHADE_DEPTH_INPUT_IS_REVERSED=1,RESHADE_DEPTH_INPUT_IS_UPSIDE_DOWN=0,RESHADE_DEPTH_INPUT_IS_LOGARITHMIC=0,RESHADE_DEPTH_LINEARIZATION_FAR_PLANE=1000"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-legacy}/ReShade.ini",
      "section": "OVERLAY",
      "key": "TutorialProgress",
      "value": "4"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-legacy}/ReShade.ini",
      "section": "OVERLAY",
      "key": "ShowClock",
      "value": "0"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-legacy}/ReShade.ini",
      "section": "OVERLAY",
      "key": "ShowFPS",
      "value": "0"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-legacy}/ReShadePreset.ini",
      "section": "",
      "key": "Techniques",
      "value": "MCPassthrough@MCPassthrough.fx"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-legacy}/ReShadePreset.ini",
      "section": "",
      "key": "TechniqueSorting",
      "value": "MCPassthrough@MCPassthrough.fx"
    },
    {
      "action": "copy",
      "download": "mc-passthrough-asi",
      "to": "{game:gta-v-legacy}"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-legacy}/MCPassthrough.ini",
      "section": "Minecraft",
      "key": "LookSensitivity",
      "value": "1.0"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-legacy}/MCPassthrough.ini",
      "section": "Minecraft",
      "key": "InvertLook",
      "value": "0"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-legacy}/MCPassthrough.ini",
      "section": "Minecraft",
      "key": "FreeLook",
      "value": "1"
    },
    {
      "action": "ini-set",
      "file": "{game:gta-v-legacy}/MCPassthrough.ini",
      "section": "Minecraft",
      "key": "KeepMinimap",
      "value": "0"
    },
    {
      "action": "prism-instance"
    },
    {
      "action": "xml-set",
      "file": "{documents}/Rockstar Games/GTA V/settings.xml",
      "element": "PauseOnFocusLoss",
      "attribute": "value",
      "value": "0"
    },
    {
      "action": "xml-set",
      "file": "{documents}/Rockstar Games/GTA V/settings.xml",
      "element": "Windowed",
      "attribute": "value",
      "value": "2"
    }
  ],
  "launch": {
    "steps": [
      {
        "order": 1,
        "target": "prism",
        "waitFor": {
          "logFile": "{prism-instance}/logs/latest.log",
          "pattern": "host link listening",
          "message": "Getting Minecraft ready. The first start downloads Minecraft and takes a few minutes.",
          "timeoutSeconds": 1800
        }
      },
      {
        "order": 2,
        "target": "game",
        "gameKey": "gta-v-legacy",
        "via": "steam",
        "args": [
          "-nobattleye"
        ]
      }
    ],
    "ready": {
      "logFile": "{prism-instance}/logs/latest.log",
      "pattern": "host connected from"
    }
  },
  "saves": [
    {
      "gameKey": "gta-v-legacy",
      "path": "{documents}/Rockstar Games/GTA V/Profiles"
    },
    {
      "gameKey": "minecraft-java",
      "path": "{prism-instance}/saves"
    }
  ],
  "requirements": {
    "notes": "Both games render at once, so it needs a strong PC. GTA runs windowed with Pause on focus loss off; turn depth of field off in GTA's graphics settings. Minecraft's window stays open in the background."
  },
