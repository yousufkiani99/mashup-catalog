{
  "schemaVersion": 1,
  "id": "peakcraft",
  "title": "PeakCraft",
  "tagline": "Climb PEAK as a Minecraft player: pillar up, dig in and build your way to the summit.",
  "description": "Take on PEAK's mountain with Minecraft's movement, blocks, hand and hotbar. Pillar up cliffs, bridge gaps, break and place blocks and dig into the mountain. Press 9 or F10 to switch to PEAK's own climbing whenever you want, and back again. Every new climb starts with a fresh Minecraft world. Both games run at the same time: Minecraft runs hidden and PEAK draws everything.",
  "method": "passthrough",
  "tier": "unlocked",
  "testLabel": "beta",
  "games": [
    {
      "role": "host",
      "key": "peak",
      "name": "PEAK",
      "store": "steam",
      "steamAppId": "3527290",
      "version": {
        "kind": "any",
        "note": "Any current Steam version with BepInEx 5."
      }
    },
    {
      "role": "guest",
      "key": "minecraft-java",
      "name": "Minecraft: Java Edition",
      "store": "minecraft",
      "version": {
        "kind": "any",
        "note": "A Microsoft account that owns Minecraft: Java Edition. The app sets up Minecraft 26.3 itself."
      }
    }
  ],
  "minecraft": {
    "gameVersion": "26.3",
    "loader": "fabric",
    "loaderVersion": "0.19.5",
    "fabricApiVersion": "0.161.0+26.3",
    "javaMajor": 25,
    "mods": [
      "skycraft-fabric",
      "fabric-api"
    ],
    "instanceName": "PeakCraft",
    "jvmArgs": [
      "--enable-native-access=ALL-UNNAMED",
      "-Dskycraft.startHidden=true"
    ],
    "maxMemoryMb": 4096
  },
  "downloads": [
    {
      "id": "peakcraft",
      "name": "PeakCraft 1.0.0 (PEAK side)",
      "url": "https://github.com/Keel62155/Minecraft-X-Games/releases/download/1.0.0-PEAK/PeakCraft.zip",
      "sha256": "ae3d79de78390c05e8964e018d5fa19170595ad8d144b918c9b65d81ef4747a9",
