  "steps": [
    {
      "action": "extract",
      "download": "bepinexpack-peak",
      "to": "{game:peak}",
      "from": "BepInExPack_PEAK"
    },
    {
      "action": "extract",
      "download": "peakcraft",
      "to": "{game:peak}/BepInEx/plugins/PeakCraft",
      "from": "PeakCraft",
      "only": [
        "PeakCraft.dll"
      ]
    },
    {
      "action": "prism-instance"
    }
  ],
  "launch": {
    "steps": [
      {
        "order": 1,
        "target": "prism",
        "waitFor": {
          "logFile": "{prism-instance}/logs/latest.log",
          "pattern": "SkyCraft: game window hidden",
          "message": "Getting Minecraft ready. The first start downloads Minecraft and takes a few minutes.",
          "timeoutSeconds": 1800
        }
      },
      {
        "order": 2,
        "target": "game",
        "gameKey": "peak",
        "via": "steam"
      }
    ],
    "ready": {
      "logFile": "{prism-instance}/logs/latest.log",
      "pattern": "SkyCraft: linked to"
    }
  },
  "saves": [
    {
      "gameKey": "peak",
      "path": "{locallow}/LandCrab/PEAK"
    },
    {
      "gameKey": "minecraft-java",
      "path": "{prism-instance}/saves"
    }
  ],
  "requirements": {
    "ramGb": 3,
    "notes": "About 3 GB of extra RAM for Minecraft."
  },
