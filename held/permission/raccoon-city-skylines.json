  "steps": [
    {
      "action": "extract",
      "download": "reframework",
      "to": "{game:resident-evil-2}",
      "only": [
        "dinput8.dll"
      ]
    },
    {
      "action": "run",
      "download": "reshade-setup",
      "args": [
        "{exe:resident-evil-2}",
        "--api",
        "dxgi",
        "--headless"
      ],
      "waitForExit": true,
      "note": "Installs ReShade (the version with add-on support) into Resident Evil 2 as dxgi.dll. Nothing shows on screen."
    },
    {
      "action": "ini-set",
      "file": "{game:resident-evil-2}/ReShade.ini",
      "section": "GENERAL",
      "key": "EffectSearchPaths",
      "value": ".\\reshade-shaders\\Shaders"
    },
    {
      "action": "ini-set",
      "file": "{game:resident-evil-2}/ReShade.ini",
      "section": "GENERAL",
      "key": "PresetPath",
      "value": ".\\ReShadePreset.ini"
    },
    {
      "action": "ini-set",
      "file": "{game:resident-evil-2}/ReShade.ini",
      "section": "GENERAL",
      "key": "PreprocessorDefinitions",
      "value": "RESHADE_DEPTH_INPUT_IS_REVERSED=1"
    },
    {
      "action": "ini-set",
      "file": "{game:resident-evil-2}/ReShade.ini",
      "section": "OVERLAY",
      "key": "TutorialProgress",
      "value": "4"
    },
    {
      "action": "ini-set",
      "file": "{game:resident-evil-2}/ReShadePreset.ini",
      "section": "",
      "key": "Techniques",
      "value": "RaccoonSkylines@RaccoonSkylines.fx"
    },
    {
      "action": "ini-set",
      "file": "{game:resident-evil-2}/ReShadePreset.ini",
      "section": "",
      "key": "TechniqueSorting",
      "value": "RaccoonSkylines@RaccoonSkylines.fx"
    },
    {
      "action": "copy",
      "download": "reshade-fxh",
      "to": "{game:resident-evil-2}/reshade-shaders/Shaders"
    },
    {
      "action": "extract",
      "download": "raccoon-city-skylines",
      "to": "{game:resident-evil-2}",
      "from": "RaccoonCitySkylines/Resident_Evil_2",
      "only": [
        "reframework/plugins/RaccoonSkylines.dll",
        "reframework/autorun/raccoon_skylines.lua",
        "reshade-shaders/Shaders/RaccoonSkylines.fx"
      ]
    },
    {
      "action": "mkdir",
      "path": "{localappdata}/Colossal Order/Cities_Skylines/Addons/Mods/RaccoonCitySkylines"
    },
    {
      "action": "extract",
      "download": "raccoon-city-skylines",
      "to": "{localappdata}/Colossal Order/Cities_Skylines/Addons/Mods/RaccoonCitySkylines",
      "from": "RaccoonCitySkylines/Cities_Skylines/RaccoonCitySkylines"
    }
  ],
  "launch": {
    "steps": [
      {
        "order": 1,
        "target": "game",
        "gameKey": "cities-skylines",
        "via": "steam",
        "args": [
          "--continuelastsave",
          "-screen-fullscreen",
          "0",
          "-screen-width",
          "960",
          "-screen-height",
          "540"
        ],
        "waitSeconds": 60
      },
      {
        "order": 2,
        "target": "game",
        "gameKey": "resident-evil-2",
        "via": "steam"
      }
    ],
    "ready": {
      "logFile": "{game:resident-evil-2}/reframework/data/raccoon_skylines/plugin.log",
      "pattern": "link: connected to the city"
    }
  },
  "saves": [
    {
      "gameKey": "cities-skylines",
      "path": "{localappdata}/Colossal Order/Cities_Skylines/Saves"
    }
  ],
  "requirements": {
    "notes": "Both games run at once, so a PC that runs each comfortably on its own. Cities: Skylines runs in a small 960x540 window, which keeps it light."
  },
