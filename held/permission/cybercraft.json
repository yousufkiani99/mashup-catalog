{
  "schemaVersion": 1,
  "id": "cybercraft",
  "title": "CyberCraft",
  "tagline": "Play Cyberpunk 2077 as a Minecraft player: build, break and fight across Night City.",
  "description": "Walk Night City with Minecraft's movement, hand and hotbar. Build on its streets and rooftops, break blocks, hit people with Minecraft weapons, set them alight with fire and lava, and blow things up with TNT. While Minecraft has V, Minecraft's hotbar is all you carry; press F10 to hand V back to the game to talk, shop or drive. Both games run at the same time: Minecraft runs hidden and Cyberpunk draws everything.",
  "method": "passthrough",
  "tier": "unlocked",
  "testLabel": "beta",
  "games": [
    {
      "role": "host",
      "key": "cyberpunk-2077",
      "name": "Cyberpunk 2077",
      "store": "steam",
      "steamAppId": "1091500",
      "version": {
        "kind": "any",
        "note": "Made for game patch 2.31. After a game update it waits for a RED4ext that supports it."
      }
    },
    {
      "role": "guest",
      "key": "minecraft-java",
      "name": "Minecraft: Java Edition",
      "store": "minecraft",
      "version": {
        "kind": "any",
        "note": "A Microsoft account that owns Minecraft: Java Edition. The app sets up Minecraft 26.3 itself."
      }
    }
  ],
  "minecraft": {
    "gameVersion": "26.3",
    "loader": "fabric",
    "loaderVersion": "0.19.5",
    "fabricApiVersion": "0.161.0+26.3",
    "javaMajor": 25,
    "mods": [
      "skycraft-fabric",
      "fabric-api"
    ],
    "instanceName": "CyberCraft",
    "jvmArgs": [
      "--enable-native-access=ALL-UNNAMED",
      "-Dskycraft.startHidden=true"
    ],
    "maxMemoryMb": 4096
  },
  "downloads": [
    {
      "id": "cybercraft",
      "name": "CyberCraft 2.0.0 (Cyberpunk side)",
      "url": "https://github.com/Keel62155/Minecraft-X-Games/releases/download/2.0.0-CyberCraft/CyberCraft.zip",
      "sha256": "872b489983359b8b516daf6b46ed88b9783de8f0299d44c0db3b7b79cac03f3b",
      "sizeBytes": 190437,
      "kind": "mashup",
      "source": "github-release",
      "licence": "No licence: used only with the creator's written permission",
      "fileName": "CyberCraft.zip"
    },
    {
      "id": "skycraft-fabric",
      "name": "SkyCraft 0.1.2 (Minecraft side, shared by every Minecraft X Games mod)",
      "url": "https://github.com/chasmlol/SkyCraft/releases/download/v0.1.2/skycraft-fabric-0.1.2.jar",
      "sha256": "ea429c73dcec49d39b6a0bb9b17ad08a6b0290a39a96ccf6f6c07d581cf992d9",
      "sizeBytes": 247869,
      "kind": "dependency",
      "source": "github-release",
      "licence": "MIT",
      "fileName": "skycraft-fabric-0.1.2.jar"
    },
    {
      "id": "red4ext",
      "name": "RED4ext 1.30.0",
      "url": "https://github.com/wopss/RED4ext/releases/download/v1.30.0/red4ext-1.30.0.zip",
      "sha256": "3a72225c9d2c46c99f4a4159d952b9d24366357c2423eb7ea255c84e9e11c0b0",
      "sizeBytes": 575834,
      "kind": "loader",
      "source": "github-release",
      "licence": "MIT",
      "fileName": "red4ext-1.30.0.zip"
    },
    {
      "id": "reshade-setup",
      "name": "ReShade 6.8.0 with full add-on support",
      "url": "https://reshade.me/downloads/ReShade_Setup_6.8.0_Addon.exe",
      "sha256": "afe4c8f13048306307983b8b3d41d5bf00a86820440b0e57dea10950e1176445",
      "kind": "loader",
      "source": "official-site",
      "licence": "ReShade: free; binaries are downloaded from reshade.me only",
      "fileName": "ReShade_Setup_6.8.0_Addon.exe",
      "pins": {
        "version": "6.8.0",
        "fileSha256": [
          "0cee63f9c9f13f3ac909c5b4903f4dbb4b719a7ab3b4f13b0deaf83c814b94f7"
        ]
      }
    },
    {
      "id": "prism-launcher",
      "name": "Prism Launcher 11.1.1 (portable)",
      "url": "https://github.com/PrismLauncher/PrismLauncher/releases/download/11.1.1/PrismLauncher-Windows-MSVC-Portable-11.1.1.zip",
      "sha256": "ab35a770fb06d89d2ccc098079db5db329fb4e68f42b72babd8b095efde3d2d7",
      "sizeBytes": 20396629,
      "kind": "tool",
      "source": "github-release",
      "licence": "GPL-3.0-only",
      "fileName": "PrismLauncher-Windows-MSVC-Portable-11.1.1.zip"
    },
    {
      "id": "fabric-api",
      "name": "Fabric API 0.161.0 for Minecraft 26.3",
      "url": "https://github.com/FabricMC/fabric/releases/download/0.161.0%2B26.3/fabric-api-0.161.0%2B26.3.jar",
      "sha256": "86f16178a3cecc887a85a4cfe9a79d92fa7341d8f39b5951a4d6ad800ab657a6",
      "sizeBytes": 2620967,
      "kind": "dependency",
      "source": "github-release",
      "licence": "Apache-2.0",
      "fileName": "fabric-api-0.161.0+26.3.jar"
    }
  ],
  "steps": [
    {
      "action": "extract",
      "download": "red4ext",
      "to": "{game:cyberpunk-2077}"
    },
    {
      "action": "run",
      "download": "reshade-setup",
      "args": [
        "{exe:cyberpunk-2077}",
        "--api",
        "dxgi",
        "--headless"
      ],
      "waitForExit": true,
      "note": "Installs ReShade (the version with add-on support) into Cyberpunk as dxgi.dll. Nothing shows on screen."
    },
    {
      "action": "ini-set",
      "file": "{game:cyberpunk-2077}/bin/x64/ReShade.ini",
      "section": "GENERAL",
      "key": "EffectSearchPaths",
      "value": ".\\reshade-shaders\\Shaders"
    },
    {
      "action": "extract",
      "download": "cybercraft",
      "to": "{game:cyberpunk-2077}",
      "from": "CyberCraft",
      "only": [
        "red4ext/plugins/CyberCraft/CyberCraft.dll",
        "bin/x64/reshade-shaders/Shaders/CyberCraft.fx"
      ]
    },
    {
      "action": "prism-instance"
    }
  ],
  "launch": {
    "steps": [
      {
        "order": 1,
        "target": "prism",
        "waitFor": {
          "logFile": "{prism-instance}/logs/latest.log",
          "pattern": "SkyCraft: game window hidden",
          "message": "Getting Minecraft ready. The first start downloads Minecraft and takes a few minutes.",
          "timeoutSeconds": 1800
        }
      },
      {
        "order": 2,
        "target": "game",
        "gameKey": "cyberpunk-2077",
        "via": "steam"
      }
    ],
    "ready": {
      "logFile": "{prism-instance}/logs/latest.log",
      "pattern": "SkyCraft: linked to"
    }
  },
  "saves": [
    {
      "gameKey": "cyberpunk-2077",
      "path": "{savedgames}/CD Projekt Red/Cyberpunk 2077"
    },
    {
      "gameKey": "minecraft-java",
      "path": "{prism-instance}/saves"
    }
  ],
  "requirements": {
    "ramGb": 3,
    "notes": "About 3 GB of extra RAM for Minecraft, and a PC that runs Cyberpunk comfortably on its own."
  },
  "credits": [
    {
      "name": "Keel62155",
      "role": "Creator of CyberCraft",
      "url": "https://github.com/Keel62155"
    },
    {
      "name": "chasmlol",
      "role": "Creator of SkyCraft, whose Minecraft side this mashup runs on",
      "url": "https://github.com/chasmlol/SkyCraft"
    },
    {
      "name": "wopss",
      "role": "RED4ext, Cyberpunk's plugin loader",
      "url": "https://github.com/wopss/RED4ext"
    },
    {
      "name": "crosire",
      "role": "ReShade and its add-on API",
      "url": "https://reshade.me"
    }
  ],
  "licence": {
    "spdx": "none",
    "url": "https://github.com/Keel62155/Minecraft-X-Games",
    "permission": "pending"
  },
  "links": {
    "source": "https://github.com/Keel62155/Minecraft-X-Games",
    "manualInstall": "https://github.com/Keel62155/Minecraft-X-Games/releases/tag/2.0.0-CyberCraft"
  },
  "media": {},
  "aiBuilt": true,
  "knownIssues": [
    "A prototype played on one PC. Hiding blocks behind the game's world and keeping your keys away from the game are new and untested.",
    "To talk to someone, shop or drive, press F10 first: the game doesn't get your keys while Minecraft has V.",
    "People don't hurt Minecraft's player and barely react to being hit.",
    "In a vehicle or on a moving lift the game has V until you're on foot again.",
    "If blocks show through walls, press Home, find CyberCraft and tick \"Show the game's depth\"; if the picture isn't grey by distance, try the other depth buffers under Add-ons, Generic Depth.",
    "After a game update it stops until a new RED4ext comes out.",
    "Only one Minecraft X Games mashup can run at a time: they all drive the same kind of hidden Minecraft."
  ],
  "important": [
    {
      "text": "In Cyberpunk's graphics settings, turn frame generation (DLSS or FSR) off. With it on, Minecraft's picture flickers.",
      "blocksInstall": false
    }
  ]
}
